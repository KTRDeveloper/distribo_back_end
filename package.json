{
  "name": "node-ts-express-prisma-boilerplate",
  "version": "1.0.0",
  "description": "Production-ready Node.js boilerplate with TypeScript, Express, Prisma, Redis, and BullMQ",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,task-worker,otp-worker -c blue,green,magenta \"npm:dev:server\" \"npm:worker:dev\" \"npm:otp-worker:dev\"",
    "dev:server": "nodemon --exec tsx src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db:up": "docker compose -f docker/docker-compose.test.yml up -d && sleep 3",
    "test:db:down": "docker compose -f docker/docker-compose.test.yml down -v",
    "test:db:setup": "npm run test:db:up && DATABASE_URL=postgresql://postgres:postgres@localhost:5434/test_db npx prisma migrate deploy",
    "test:integration": "npm run test:db:setup && vitest run tests/integration && npm run test:db:down",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "job:reconcile": "tsx src/jobs/reconcile.ts",
    "job:purge": "tsx src/jobs/purge.ts",
    "job:image-cleanup": "tsx src/jobs/image-cleanup.ts",
    "admin:create-super": "tsx scripts/create-super-admin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "worker": "node dist/workers/task-worker.js",
    "worker:dev": "nodemon --exec tsx src/workers/task-worker.ts",
    "otp-worker": "node dist/workers/otp-delivery-worker.js",
    "otp-worker:dev": "nodemon --exec tsx src/workers/otp-delivery-worker.ts"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "prisma",
    "template",
    "boilerplate",
    "redis",
    "bullmq",
    "jwt",
    "authentication"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@casl/ability": "7.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.1",
    "@opentelemetry/sdk-node": "^0.56.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.0.0",
    "@textbee/sdk": "^0.2.0",
    "argon2": "0.45.1",
    "bullmq": "^5.63.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.14",
    "nodemailer": "^6.9.16",
    "otplib": "13.5.0",
    "pg": "^8.23.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^4.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^4.1.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.6.0",
    "prisma": "^7.0.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
