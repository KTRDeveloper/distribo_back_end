# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# OpenTelemetry (optional)
OTEL_SERVICE_NAME=node-ts-template
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Worker Settings
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3

# Remote Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONFIG_ENCRYPTION_KEY=your-base64-encoded-32-byte-encryption-key-change-this

# SMS (TextBee) — primary phone/OTP sign-in and password-reset delivery
TEXTBEE_API_KEY=your-textbee-api-key

# SMTP (Nodemailer) — secondary password-reset OTP channel + email verification
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_ADDRESS=no-reply@example.com

# OTP delivery queue (BullMQ)
OTP_DELIVERY_QUEUE_NAME=otp-delivery

# Minutes to wait after 5 failed logins
LOGIN_LOCK_MINUTES=5

# Public base address of stored images: http or https, no trailing slash, no query, no fragment
IMAGE_PUBLIC_BASE_URL=http://localhost:3000/images
