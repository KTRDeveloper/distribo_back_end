// Prisma schema for Node.js template project
// See data-model.md for detailed entity specifications

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum TaskStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// Task model for background jobs
model Task {
  id           String     @id @default(uuid())
  type         String
  accountId    String
  parameters   Json
  status       TaskStatus @default(QUEUED)
  priority     Int        @default(0)
  progress     Int        @default(0)
  errorMessage String?
  retryCount   Int        @default(0)
  submittedAt  DateTime   @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  result  TaskResult?

  @@index([accountId, status])
  @@index([status, submittedAt])
  @@index([completedAt])
  @@map("tasks")
}

// Task result model
model TaskResult {
  id          String   @id @default(uuid())
  taskId      String   @unique
  outputPath  String
  metadata    Json
  storageSize BigInt
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  // Relationships
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("task_results")
}

// Phone/OTP authentication (002-sms-otp-auth): superseded PasswordResetToken
// (email-link reset, never fully wired) with OTP-based sign-in and reset.

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

enum OtpChannel {
  SMS
  EMAIL
}

model OtpChallenge {
  id         String     @id @default(uuid())
  accountId  String
  purpose    OtpPurpose
  channel    OtpChannel @default(SMS)
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  // Relationships
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model EmailVerificationRequest {
  id          String    @id @default(uuid())
  accountId   String
  email       String
  codeHash    String
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  // Relationships
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, confirmedAt])
  @@index([expiresAt])
  @@map("email_verification_requests")
}

// Remote Configuration models

// System configuration model
model SystemConfig {
  id               String    @id @default(uuid())
  category         String
  key              String
  value            String    @db.Text
  isSensitive      Boolean   @default(false)
  isProtected      Boolean   @default(false)
  enabled          Boolean   @default(true)
  description      String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  lastValidatedAt  DateTime?
  validationStatus String?
  validationError  String?   @db.Text

  // Relationships
  history ConfigHistory[]

  @@unique([category, key])
  @@index([category])
  @@index([category, enabled])
  @@index([updatedAt])
  @@map("system_config")
}

// Configuration change history model
model ConfigHistory {
  id            String   @id @default(uuid())
  configId      String
  action        String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  changedAt     DateTime @default(now())
  changedBy     String?
  reason        String?  @db.Text

  // Relationships
  config SystemConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([changedAt])
  @@index([changedBy])
  @@map("config_history")
}

// =====================================================================
// Delivery domain models begin below (see specs/001-delivery-data-model/)
// Source of truth: data-model/modele-donnees-livraisons.md
// Prisma mapping decisions: specs/001-delivery-data-model/research.md
// =====================================================================

// --- Foundational: cross-cutting enums (research.md §10a for @@map values) ---

enum PartyType {
  PERSON
  ORGANIZATION
}

enum Language {
  FR
  EN
}

enum PersonStatus {
  ACTIVE
  SUSPENDED
  ANONYMIZED
}

enum OrganizationType {
  BUSINESS
  CONTRACTOR
}

// --- Foundational: root entities every other domain model references ---

model Person {
  id                String       @id @default(uuid())
  fullName          String?
  phoneNumber       String       @unique
  phoneVerifiedAt   DateTime?
  email             String?      @unique
  emailVerifiedAt   DateTime?
  preferredLanguage Language?
  createdAt         DateTime     @default(now())
  status            PersonStatus @default(ACTIVE)
  anonymizedAt      DateTime?

  // Relationships
  account                   Account?
  phoneChangeLogs           PhoneNumberChangeLog[]
  customers                 Customer[]
  reassignmentsAsPrevious   CustomerPersonReassignment[] @relation("reassignmentPrevious")
  reassignmentsAsNew        CustomerPersonReassignment[] @relation("reassignmentNew")

  @@map("people")
}

model Account {
  id                  String    @id @default(uuid())
  personId            String    @unique
  passwordHash        String
  passwordChangedAt   DateTime  @default(now())
  tokenVersion        Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Relationships
  person                    Person                       @relation(fields: [personId], references: [id])
  ownedOrganizations        Organization[]
  collaborations            Collaboration[]
  reassignmentsMade         CustomerPersonReassignment[]
  tasks                     Task[]
  otpChallenges             OtpChallenge[]
  emailVerificationRequests EmailVerificationRequest[]

  @@index([lockedUntil])
  @@index([deletedAt])
  @@map("accounts")
}

model Organization {
  id             String           @id @default(uuid())
  type           OrganizationType
  name           String
  ownerAccountId String
  createdAt      DateTime         @default(now())

  // Relationships
  ownerAccount   Account         @relation(fields: [ownerAccountId], references: [id])
  customers      Customer[]
  positions      Position[]
  collaborations Collaboration[]

  @@index([ownerAccountId])
  @@map("organizations")
}

// --- User Story 1: identity, organizations and access (spec.md P1) ---

enum CollaborationStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum PermissionDomain {
  SALES
  STOCK
  FINANCE
  DELIVERY
  HR_ACCESS
  CONTRACTORS
}

model PhoneNumberChangeLog {
  id             String   @id @default(uuid())
  personId       String
  oldPhoneNumber String
  newPhoneNumber String
  verifiedAt     DateTime
  changedAt      DateTime @default(now())

  person Person @relation(fields: [personId], references: [id])

  @@index([personId])
  @@map("phone_number_change_logs")
}

model Customer {
  id              String   @id @default(uuid())
  personId        String
  organizationId  String
  displayLabel    String?
  deliveryAddress String?
  preferences     Json?
  createdAt       DateTime @default(now())

  person        Person                       @relation(fields: [personId], references: [id])
  organization  Organization                 @relation(fields: [organizationId], references: [id])
  reassignments CustomerPersonReassignment[]

  @@unique([personId, organizationId])
  @@map("customers")
}

model CustomerPersonReassignment {
  id               String   @id @default(uuid())
  customerId       String
  previousPersonId String
  newPersonId      String
  reassignedById   String
  reason           String?  @db.Text
  reassignedAt     DateTime @default(now())

  customer       Customer @relation(fields: [customerId], references: [id])
  previousPerson Person   @relation("reassignmentPrevious", fields: [previousPersonId], references: [id])
  newPerson      Person   @relation("reassignmentNew", fields: [newPersonId], references: [id])
  reassignedBy   Account  @relation(fields: [reassignedById], references: [id])

  @@index([customerId])
  @@map("customer_person_reassignments")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  displayName String
  domain      PermissionDomain

  positions PositionPermission[]

  @@map("permissions")
}

model Position {
  id              String  @id @default(uuid())
  organizationId  String
  name            String
  isOwnerPosition Boolean @default(false)

  organization   Organization         @relation(fields: [organizationId], references: [id])
  permissions    PositionPermission[]
  collaborations Collaboration[]

  @@index([organizationId])
  @@map("positions")
}

model PositionPermission {
  positionId   String
  permissionId String

  position   Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([positionId, permissionId])
  @@map("position_permissions")
}

model Collaboration {
  id             String              @id @default(uuid())
  accountId      String
  positionId     String
  organizationId String
  status         CollaborationStatus @default(INVITED)
  invitedAt      DateTime            @default(now())
  acceptedAt     DateTime?

  account      Account      @relation(fields: [accountId], references: [id])
  position     Position     @relation(fields: [positionId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([accountId])
  @@index([organizationId])
  @@map("collaborations")
}
