// Prisma schema for Node.js template project
//
// Database rules Prisma cannot express are listed in a comment above each
// model, with the migration that holds them (see CLAUDE.md). Shared by several
// models:
// - role distribo_app (no login) has USAGE on schema public and, by default
//   privileges, SELECT, INSERT, UPDATE, DELETE on every table created later;
//   immutable tables revoke some of these
//   (20260930220000_app_role_and_server_time);
// - function set_server_updated_at(): BEFORE INSERT OR UPDATE triggers use it
//   to set server_updated_at to the server time on every write, whatever the
//   client sends (20260930220000_app_role_and_server_time);
// - function require_registered_person(columns...): trigger function that
//   rejects (23514) a row whose named person column points to a person
//   without registered_at; unchanged values on UPDATE are not rechecked
//   (20261003091410_per_008_registered_person_guard).

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Task {
  id           String     @id @default(uuid())
  type         String
  accountId    String     @map("account_id") @db.Uuid
  parameters   Json
  status       TaskStatus @default(QUEUED)
  priority     Int        @default(0)
  progress     Int        @default(0)
  errorMessage String?
  retryCount   Int        @default(0)
  submittedAt  DateTime   @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  person Person      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  result TaskResult?

  @@index([accountId, status])
  @@index([status, submittedAt])
  @@index([completedAt])
  @@map("tasks")
}

model TaskResult {
  id          String   @id @default(uuid())
  taskId      String   @unique
  outputPath  String
  metadata    Json
  storageSize BigInt
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("task_results")
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
  PHONE_CHANGE
  EMAIL_VERIFICATION
  TOTP_RECOVERY
}

enum OtpChannel {
  SMS
  EMAIL
}

enum Language {
  FR
  EN
}

enum PersonStatus {
  ACTIVE
  SUSPENDED
  ANONYMIZED
}

enum RefreshTokenRevokedReason {
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  PASSWORD_RESET
  ACCOUNT_LOCKED
  DEVICE_REMOVED
  ACCOUNT_SUSPENDED
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum NotificationReadStatus {
  UNREAD
  READ
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CollaborationRole {
  OWNER
  MANAGER
  SELLER
  DRIVER
}

enum CollaborationStatus {
  INVITED
  ACTIVE
  REVOKED
}

model SystemConfig {
  id               String    @id @default(uuid())
  category         String
  key              String
  value            String    @db.Text
  isSensitive      Boolean   @default(false)
  isProtected      Boolean   @default(false)
  enabled          Boolean   @default(true)
  description      String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  lastValidatedAt  DateTime?
  validationStatus String?
  validationError  String?   @db.Text

  history ConfigHistory[]

  @@unique([category, key])
  @@index([category])
  @@index([category, enabled])
  @@index([updatedAt])
  @@map("system_config")
}

model ConfigHistory {
  id            String   @id @default(uuid())
  configId      String
  action        String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  changedAt     DateTime @default(now())
  changedBy     String?
  reason        String?  @db.Text

  config SystemConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([changedAt])
  @@index([changedBy])
  @@map("config_history")
}

// Enforced only in the database (Prisma cannot express them):
// - email is not @unique: unique index people_verified_email_lower_unique on
//   lower(email) where email_verified_at is not null, so only verified emails
//   are unique, case-insensitively (20261002060000_per_003_person_checks);
// - CHECK people_phone_number_e164_check and
//   people_released_phone_number_e164_check: E.164, ^\+[1-9][0-9]{7,14}$
//   (20261002060000_per_003_person_checks);
// - CHECK people_exactly_one_phone_check: exactly one of phone_number and
//   released_phone_number is set (20261002060000_per_003_person_checks);
// - CHECK people_anonymized_phone_check: an ANONYMIZED person has no
//   phone_number (20261002060000_per_003_person_checks);
// - CHECK people_phone_verification_check: phone_verified_at needs a
//   phone_number (20261002060000_per_003_person_checks);
// - CHECK people_registered_completeness_check: a registered person, unless
//   ANONYMIZED, has a non-blank full_name and password_hash and a verified
//   phone_number if any; blank means only Unicode White_Space
//   (20261003061000_fnd_011_person_unicode_whitespace);
// - CHECK people_email_verification_check: email_verified_at needs a
//   non-blank email (20261003061000_fnd_011_person_unicode_whitespace);
// - trigger set_server_updated_at_people (20261002051743_per_002_person_v10);
// - trigger people_clear_public_contact: setting phone_number to null clears
//   collaborations.is_public_contact (20261004110000_org_003_collaborations).
model Person {
  id                  String         @id @db.Uuid
  otpChallenges       OtpChallenge[]
  devices             Device[]
  refreshTokens       RefreshToken[]
  fullName            String?        @map("full_name")
  phoneNumber         String?        @unique @map("phone_number")
  releasedPhoneNumber String?        @map("released_phone_number")
  phoneVerifiedAt     DateTime?      @map("phone_verified_at")
  email               String?
  emailVerifiedAt     DateTime?      @map("email_verified_at")
  passwordHash        String?        @map("password_hash")
  registeredAt        DateTime?      @map("registered_at")
  preferredLanguage   Language?      @map("preferred_language")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  status              PersonStatus   @default(ACTIVE)
  anonymizedAt        DateTime?      @map("anonymized_at")
  serverUpdatedAt     DateTime       @default(now()) @map("server_updated_at") @db.Timestamptz
  scopeVersion        Int            @default(0) @map("scope_version")

  tasks                 Task[]
  phoneNumberChangeLogs PhoneNumberChangeLog[]
  idempotencyKeys       IdempotencyKey[]
  notifications         Notification[]
  collaborations        Collaboration[]

  @@map("people")
}

// Enforced only in the database (Prisma cannot express them):
// - CHECK notifications_related_entity_pair_check: related_entity_type and
//   related_entity_id are both set or both null
//   (20261003122500_ntf_001_notifications);
// - CHECK notifications_content_check: at most 2000 characters, not blank
//   (20261003134000_ntf_002_notify_validation);
// - CHECK notifications_source_event_check: at most 100 characters, dotted
//   lowercase, ^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$
//   (20261003134000_ntf_002_notify_validation);
// - CHECK notifications_related_entity_type_check: null, or at most 100
//   characters and not blank (20261003134000_ntf_002_notify_validation);
// - deferred constraint trigger notifications_require_registered_recipient:
//   at commit, recipient_id is a registered person
//   (20261003122500_ntf_001_notifications);
// - trigger notifications_set_server_updated_at
//   (20261003122500_ntf_001_notifications).
model Notification {
  id                String                 @id @db.Uuid
  recipientId       String                 @map("recipient_id") @db.Uuid
  organizationId    String?                @map("organization_id") @db.Uuid
  content           String                 @db.Text
  sourceEvent       String                 @map("source_event")
  relatedEntityType String?                @map("related_entity_type")
  relatedEntityId   String?                @map("related_entity_id") @db.Uuid
  readStatus        NotificationReadStatus @default(UNREAD) @map("read_status")
  pushedAt          DateTime?              @map("pushed_at") @db.Timestamptz
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  serverUpdatedAt   DateTime               @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt         DateTime?              @map("deleted_at") @db.Timestamptz

  recipient    Person        @relation(fields: [recipientId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([recipientId, readStatus, createdAt(sort: Desc)])
  @@map("notifications")
}

// Enforced only in migration 20261004090000_org_001_organizations (Prisma
// cannot express it):
// - trigger organizations_set_server_updated_at.
model Organization {
  id              String             @id @db.Uuid
  name            String
  description     String?            @db.Text
  email           String?
  status          OrganizationStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  serverUpdatedAt DateTime           @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz

  notifications  Notification[]
  collaborations Collaboration[]

  @@map("organizations")
}

// Enforced only in migration 20261004110000_org_003_collaborations (Prisma
// cannot express them):
// - trigger collaborations_set_server_updated_at;
// - unique (person_id, organization_id) where deleted_at is null (C-05, C-35);
//   kept out of @@unique because a deleted row must not block a new invitation;
// - unique (organization_id) where role OWNER, status ACTIVE and not deleted;
// - trigger collaborations_check_row: ACTIVE needs a registered person; a public
//   contact needs ACTIVE status and a person with a phone number;
// - deferred constraint trigger collaborations_one_active_owner: at commit, an
//   organization with non-deleted collaborations has exactly one ACTIVE OWNER,
//   so insert the OWNER in the same transaction as the first collaboration;
// - trigger people_clear_public_contact: a released phone number clears
//   is_public_contact.
model Collaboration {
  id              String              @id @db.Uuid
  personId        String              @map("person_id") @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  role            CollaborationRole
  status          CollaborationStatus
  isPublicContact Boolean             @default(false) @map("is_public_contact")
  invitedAt       DateTime            @default(now()) @map("invited_at") @db.Timestamptz
  acceptedAt      DateTime?           @map("accepted_at") @db.Timestamptz
  amountHeld      BigInt              @default(0) @map("amount_held")
  serverUpdatedAt DateTime            @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz

  person       Person       @relation(fields: [personId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("collaborations")
}

// Enforced only in migration 20261003150000_auth_001_otp_challenges (Prisma
// cannot express them):
// - CHECK otp_challenges_attempts_check: attempts at most 5;
// - CHECK otp_challenges_sms_target_check: an SMS target starts with +237.
model OtpChallenge {
  id         String     @id @db.Uuid
  personId   String?    @map("person_id") @db.Uuid
  target     String
  purpose    OtpPurpose
  channel    OtpChannel @default(SMS)
  codeHash   String     @map("code_hash")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz
  attempts   Int        @default(0)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  person Person? @relation(fields: [personId], references: [id])

  @@index([target, purpose, createdAt(sort: Desc)])
  @@map("otp_challenges")
}

model IdempotencyKey {
  personId     String   @map("person_id") @db.Uuid
  key          String   @db.Uuid
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([personId, key])
  @@map("idempotency_keys")
}

// Enforced only in migration 20261002212000_per_003_phone_change_log (Prisma
// cannot express them):
// - CHECK phone_number_change_logs_old_phone_number_e164_check and
//   phone_number_change_logs_new_phone_number_e164_check: E.164,
//   ^\+[1-9][0-9]{1,14}$;
// - trigger phone_number_change_logs_server_updated_at_trigger;
// - REVOKE UPDATE, DELETE, TRUNCATE from distribo_app: append-only journal
//   (C-32, C-39).
model PhoneNumberChangeLog {
  id              String    @id @db.Uuid
  personId        String    @map("person_id") @db.Uuid
  oldPhoneNumber  String    @map("old_phone_number")
  newPhoneNumber  String    @map("new_phone_number")
  verifiedAt      DateTime  @map("verified_at") @db.Timestamptz
  changedAt       DateTime  @map("changed_at") @db.Timestamptz
  serverUpdatedAt DateTime  @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  person Person @relation(fields: [personId], references: [id])

  @@index([personId])
  @@map("phone_number_change_logs")
}

// Enforced only in migration 20261003160000_auth_007_devices_refresh_tokens
// (Prisma cannot express it):
// - index devices_person_id_active_idx on (person_id) where revoked_at is
//   null; kept out of @@index because Prisma cannot declare its WHERE clause.
model Device {
  id               String         @id @db.Uuid
  personId         String         @map("person_id") @db.Uuid
  platform         DevicePlatform
  model            String?
  pushToken        String?        @map("push_token")
  appVersion       String         @map("app_version")
  lastSyncedAt     DateTime?      @map("last_synced_at") @db.Timestamptz
  scopeVersionSeen Int            @default(0) @map("scope_version_seen")
  integrityVerdict String?        @map("integrity_verdict")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz

  person        Person         @relation(fields: [personId], references: [id])
  refreshTokens RefreshToken[]

  @@map("devices")
}

// Enforced only in migration 20261003160000_auth_007_devices_refresh_tokens
// (Prisma cannot express it):
// - CHECK refresh_tokens_revoked_check: revoked_at and revoked_reason are both
//   set or both null.
model RefreshToken {
  id            String                     @id @db.Uuid
  personId      String                     @map("person_id") @db.Uuid
  deviceId      String                     @map("device_id") @db.Uuid
  tokenHash     String                     @unique @map("token_hash")
  expiresAt     DateTime                   @map("expires_at") @db.Timestamptz
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  rotatedAt     DateTime?                  @map("rotated_at") @db.Timestamptz
  revokedAt     DateTime?                  @map("revoked_at") @db.Timestamptz
  revokedReason RefreshTokenRevokedReason? @map("revoked_reason")

  person Person @relation(fields: [personId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])

  @@index([personId])
  @@index([deviceId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
