// Prisma schema for Node.js template project

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Task {
  id           String     @id @default(uuid())
  type         String
  accountId    String     @map("account_id") @db.Uuid
  parameters   Json
  status       TaskStatus @default(QUEUED)
  priority     Int        @default(0)
  progress     Int        @default(0)
  errorMessage String?
  retryCount   Int        @default(0)
  submittedAt  DateTime   @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  person Person      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  result TaskResult?

  @@index([accountId, status])
  @@index([status, submittedAt])
  @@index([completedAt])
  @@map("tasks")
}

model TaskResult {
  id          String   @id @default(uuid())
  taskId      String   @unique
  outputPath  String
  metadata    Json
  storageSize BigInt
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("task_results")
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
  PHONE_CHANGE
  EMAIL_VERIFICATION
  TOTP_RECOVERY
}

enum OtpChannel {
  SMS
  EMAIL
}

enum Language {
  FR
  EN
}

enum PersonStatus {
  ACTIVE
  SUSPENDED
  ANONYMIZED
}

enum RefreshTokenRevokedReason {
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  PASSWORD_RESET
  ACCOUNT_LOCKED
  DEVICE_REMOVED
  ACCOUNT_SUSPENDED
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum NotificationReadStatus {
  UNREAD
  READ
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model SystemConfig {
  id               String    @id @default(uuid())
  category         String
  key              String
  value            String    @db.Text
  isSensitive      Boolean   @default(false)
  isProtected      Boolean   @default(false)
  enabled          Boolean   @default(true)
  description      String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  lastValidatedAt  DateTime?
  validationStatus String?
  validationError  String?   @db.Text

  history ConfigHistory[]

  @@unique([category, key])
  @@index([category])
  @@index([category, enabled])
  @@index([updatedAt])
  @@map("system_config")
}

model ConfigHistory {
  id            String   @id @default(uuid())
  configId      String
  action        String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  changedAt     DateTime @default(now())
  changedBy     String?
  reason        String?  @db.Text

  config SystemConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([changedAt])
  @@index([changedBy])
  @@map("config_history")
}

model Person {
  id                  String         @id @db.Uuid
  otpChallenges       OtpChallenge[]
  devices             Device[]
  refreshTokens       RefreshToken[]
  fullName            String?        @map("full_name")
  phoneNumber         String?        @unique @map("phone_number")
  releasedPhoneNumber String?        @map("released_phone_number")
  phoneVerifiedAt     DateTime?      @map("phone_verified_at")
  email               String?
  emailVerifiedAt     DateTime?      @map("email_verified_at")
  passwordHash        String?        @map("password_hash")
  registeredAt        DateTime?      @map("registered_at")
  preferredLanguage   Language?      @map("preferred_language")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  status              PersonStatus   @default(ACTIVE)
  anonymizedAt        DateTime?      @map("anonymized_at")
  serverUpdatedAt     DateTime       @default(now()) @map("server_updated_at") @db.Timestamptz
  scopeVersion        Int            @default(0) @map("scope_version")

  tasks                 Task[]
  phoneNumberChangeLogs PhoneNumberChangeLog[]
  idempotencyKeys       IdempotencyKey[]
  notifications         Notification[]

  @@map("people")
}

model Notification {
  id                String                 @id @db.Uuid
  recipientId       String                 @map("recipient_id") @db.Uuid
  organizationId    String?                @map("organization_id") @db.Uuid
  content           String                 @db.Text
  sourceEvent       String                 @map("source_event")
  relatedEntityType String?                @map("related_entity_type")
  relatedEntityId   String?                @map("related_entity_id") @db.Uuid
  readStatus        NotificationReadStatus @default(UNREAD) @map("read_status")
  pushedAt          DateTime?              @map("pushed_at") @db.Timestamptz
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  serverUpdatedAt   DateTime               @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt         DateTime?              @map("deleted_at") @db.Timestamptz

  recipient    Person        @relation(fields: [recipientId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([recipientId, readStatus, createdAt(sort: Desc)])
  @@map("notifications")
}

model Organization {
  id              String             @id @db.Uuid
  name            String
  description     String?            @db.Text
  email           String?
  status          OrganizationStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  serverUpdatedAt DateTime           @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz

  notifications Notification[]

  @@map("organizations")
}

model OtpChallenge {
  id         String     @id @db.Uuid
  personId   String?    @map("person_id") @db.Uuid
  target     String
  purpose    OtpPurpose
  channel    OtpChannel @default(SMS)
  codeHash   String     @map("code_hash")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz
  attempts   Int        @default(0)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  person Person? @relation(fields: [personId], references: [id])

  @@index([target, purpose, createdAt(sort: Desc)])
  @@map("otp_challenges")
}

model IdempotencyKey {
  personId     String   @map("person_id") @db.Uuid
  key          String   @db.Uuid
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([personId, key])
  @@map("idempotency_keys")
}

model PhoneNumberChangeLog {
  id              String    @id @db.Uuid
  personId        String    @map("person_id") @db.Uuid
  oldPhoneNumber  String    @map("old_phone_number")
  newPhoneNumber  String    @map("new_phone_number")
  verifiedAt      DateTime  @map("verified_at") @db.Timestamptz
  changedAt       DateTime  @map("changed_at") @db.Timestamptz
  serverUpdatedAt DateTime  @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  person Person @relation(fields: [personId], references: [id])

  @@index([personId])
  @@map("phone_number_change_logs")
}

model Device {
  id               String         @id @db.Uuid
  personId         String         @map("person_id") @db.Uuid
  platform         DevicePlatform
  model            String?
  pushToken        String?        @map("push_token")
  appVersion       String         @map("app_version")
  lastSyncedAt     DateTime?      @map("last_synced_at") @db.Timestamptz
  scopeVersionSeen Int            @default(0) @map("scope_version_seen")
  integrityVerdict String?        @map("integrity_verdict")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz

  person        Person         @relation(fields: [personId], references: [id])
  refreshTokens RefreshToken[]

  @@map("devices")
}

model RefreshToken {
  id            String                     @id @db.Uuid
  personId      String                     @map("person_id") @db.Uuid
  deviceId      String                     @map("device_id") @db.Uuid
  tokenHash     String                     @unique @map("token_hash")
  expiresAt     DateTime                   @map("expires_at") @db.Timestamptz
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  rotatedAt     DateTime?                  @map("rotated_at") @db.Timestamptz
  revokedAt     DateTime?                  @map("revoked_at") @db.Timestamptz
  revokedReason RefreshTokenRevokedReason? @map("revoked_reason")

  person Person @relation(fields: [personId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])

  @@index([personId])
  @@index([deviceId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
