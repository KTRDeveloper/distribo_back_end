// Prisma schema for Node.js template project
// See data-model.md for detailed entity specifications

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum TaskStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// Task model for background jobs
model Task {
  id           String     @id @default(uuid())
  type         String
  accountId    String
  parameters   Json
  status       TaskStatus @default(QUEUED)
  priority     Int        @default(0)
  progress     Int        @default(0)
  errorMessage String?
  retryCount   Int        @default(0)
  submittedAt  DateTime   @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  result  TaskResult?

  @@index([accountId, status])
  @@index([status, submittedAt])
  @@index([completedAt])
  @@map("tasks")
}

// Task result model
model TaskResult {
  id          String   @id @default(uuid())
  taskId      String   @unique
  outputPath  String
  metadata    Json
  storageSize BigInt
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  // Relationships
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("task_results")
}

// Phone/OTP authentication (002-sms-otp-auth): superseded PasswordResetToken
// (email-link reset, never fully wired) with OTP-based sign-in and reset.

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

enum OtpChannel {
  SMS
  EMAIL
}

model OtpChallenge {
  id         String     @id @default(uuid())
  accountId  String
  purpose    OtpPurpose
  channel    OtpChannel @default(SMS)
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  // Relationships
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model EmailVerificationRequest {
  id          String    @id @default(uuid())
  accountId   String
  email       String
  codeHash    String
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  // Relationships
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, confirmedAt])
  @@index([expiresAt])
  @@map("email_verification_requests")
}

// Access/refresh token pair (005-refresh-tokens): superseded the
// Account.tokenVersion all-or-nothing revocation with a per-session,
// individually revocable refresh token.

enum RefreshTokenRevokedReason {
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  PASSWORD_RESET
  ACCOUNT_LOCKED
}

model RefreshToken {
  id            String                     @id @default(uuid())
  accountId     String
  tokenHash     String                     @unique
  expiresAt     DateTime
  createdAt     DateTime                   @default(now())
  rotatedAt     DateTime?
  revokedAt     DateTime?
  revokedReason RefreshTokenRevokedReason?

  // Relationships
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Remote Configuration models

// System configuration model
model SystemConfig {
  id               String    @id @default(uuid())
  category         String
  key              String
  value            String    @db.Text
  isSensitive      Boolean   @default(false)
  isProtected      Boolean   @default(false)
  enabled          Boolean   @default(true)
  description      String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  lastValidatedAt  DateTime?
  validationStatus String?
  validationError  String?   @db.Text

  // Relationships
  history ConfigHistory[]

  @@unique([category, key])
  @@index([category])
  @@index([category, enabled])
  @@index([updatedAt])
  @@map("system_config")
}

// Configuration change history model
model ConfigHistory {
  id            String   @id @default(uuid())
  configId      String
  action        String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  changedAt     DateTime @default(now())
  changedBy     String?
  reason        String?  @db.Text

  // Relationships
  config SystemConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([changedAt])
  @@index([changedBy])
  @@map("config_history")
}

// =====================================================================
// Delivery domain models begin below (see specs/001-delivery-data-model/)
// Source of truth: data-model/modele-donnees-livraisons.md
// Prisma mapping decisions: specs/001-delivery-data-model/research.md
// =====================================================================

// --- Foundational: cross-cutting enums (research.md §10a for @@map values) ---

enum PartyType {
  PERSON
  ORGANIZATION
}

enum Language {
  FR
  EN
}

enum PersonStatus {
  ACTIVE
  SUSPENDED
  ANONYMIZED
}

enum OrganizationType {
  BUSINESS
  CONTRACTOR
}

// --- Foundational: root entities every other domain model references ---

model Person {
  id                String       @id @default(uuid())
  fullName          String?
  phoneNumber       String       @unique
  phoneVerifiedAt   DateTime?
  email             String?      @unique
  emailVerifiedAt   DateTime?
  preferredLanguage Language?
  createdAt         DateTime     @default(now())
  status            PersonStatus @default(ACTIVE)
  anonymizedAt      DateTime?

  // Relationships
  account                 Account?
  phoneChangeLogs         PhoneNumberChangeLog[]
  customers               Customer[]
  reassignmentsAsPrevious CustomerPersonReassignment[] @relation("reassignmentPrevious")
  reassignmentsAsNew      CustomerPersonReassignment[] @relation("reassignmentNew")
  channelRelations        CustomerChannelRelation[]
  ratingsGiven            Rating[]
  notifications           Notification[]

  @@map("people")
}

model Account {
  id                  String    @id @default(uuid())
  personId            String    @unique
  passwordHash        String
  passwordChangedAt   DateTime  @default(now())
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Relationships
  person                    Person                       @relation(fields: [personId], references: [id])
  ownedOrganizations        Organization[]
  collaborations            Collaboration[]
  reassignmentsMade         CustomerPersonReassignment[]
  tasks                     Task[]
  otpChallenges             OtpChallenge[]
  emailVerificationRequests EmailVerificationRequest[]
  refreshTokens             RefreshToken[]
  stockMovementsRecorded    StockMovement[]              @relation("StockMovementRecordedBy")
  orderLineChangesMade      OrderLineChange[]            @relation("OrderLineChangeChangedBy")
  ordersEntered             Order[]                      @relation("OrderEnteredBy")
  deliveriesAssigned        Delivery[]                   @relation("DeliveryAssignedTo")
  paymentsRecorded          Payment[]                    @relation("PaymentRecordedBy")
  debtsRecorded             Debt[]                       @relation("DebtRecordedBy")
  debtSettlementsRecorded   DebtSettlement[]             @relation("DebtSettlementRecordedBy")
  refundsRecorded           Refund[]                     @relation("RefundRecordedBy")
  receiptsGenerated         Receipt[]                    @relation("ReceiptGeneratedBy")
  operatingCostsRecorded    OperatingCost[]              @relation("OperatingCostRecordedBy")
  reportsMade               Report[]                     @relation("ReportReporter")
  administrator             Administrator?
  processedActions          ProcessedAction[]

  @@index([lockedUntil])
  @@index([deletedAt])
  @@map("accounts")
}

model Organization {
  id             String           @id @default(uuid())
  type           OrganizationType
  name           String
  ownerAccountId String
  createdAt      DateTime         @default(now())

  // Relationships
  ownerAccount                         Account                   @relation(fields: [ownerAccountId], references: [id])
  customers                            Customer[]
  positions                            Position[]
  collaborations                       Collaboration[]
  productsAsBusiness                   Product[]                 @relation("ProductBusiness")
  stocks                               Stock[]
  agreementsAsBusiness                 PartnershipAgreement[]    @relation("AgreementBusiness")
  agreementsAsContractor               PartnershipAgreement[]    @relation("AgreementContractor")
  agreementsInitiated                  PartnershipAgreement[]    @relation("AgreementInitiator")
  partnershipProductsInitiated         PartnershipProduct[]      @relation("PartnershipProductInitiator")
  channelRelationsAsBusiness           CustomerChannelRelation[] @relation("ChannelRelationBusiness")
  channelRelationsAsContractor         CustomerChannelRelation[] @relation("ChannelRelationContractor")
  channelChangeRequestsAsNewContractor ChannelChangeRequest[]    @relation("ChannelChangeNewContractor")
  ordersAsRecipient                    Order[]                   @relation("OrderRecipient")
  paymentsAsCreditor                   Payment[]                 @relation("PaymentCreditor")
  debtsAsCreditor                      Debt[]                    @relation("DebtCreditor")
  refundsIssued                        Refund[]                  @relation("RefundOrganization")
  debtCeilings                         DebtCeiling[]
  subscriptions                        Subscription[]
  operatingCostCategories              OperatingCostCategory[]
  operatingCosts                       OperatingCost[]
  infoSharingRulesAsContractor         InfoSharingRule[]         @relation("InfoSharingContractor")
  infoSharingRulesAsBusiness           InfoSharingRule[]         @relation("InfoSharingBusiness")
  ratingsReceived                      Rating[]                  @relation("RatingContractor")
  notifications                        Notification[]

  @@index([ownerAccountId])
  @@map("organizations")
}

// --- User Story 1: identity, organizations and access (spec.md P1) ---

enum CollaborationStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum PermissionDomain {
  SALES
  STOCK
  FINANCE
  DELIVERY
  HR_ACCESS
  CONTRACTORS
}

model PhoneNumberChangeLog {
  id             String   @id @default(uuid())
  personId       String
  oldPhoneNumber String
  newPhoneNumber String
  verifiedAt     DateTime
  changedAt      DateTime @default(now())

  person Person @relation(fields: [personId], references: [id])

  @@index([personId])
  @@map("phone_number_change_logs")
}

model Customer {
  id              String   @id @default(uuid())
  personId        String
  organizationId  String
  displayLabel    String?
  deliveryAddress String?
  preferences     Json?
  createdAt       DateTime @default(now())

  person            Person                       @relation(fields: [personId], references: [id])
  organization      Organization                 @relation(fields: [organizationId], references: [id])
  reassignments     CustomerPersonReassignment[]
  sharingExceptions CustomerSharingException[]

  @@unique([personId, organizationId])
  @@map("customers")
}

model CustomerPersonReassignment {
  id               String   @id @default(uuid())
  customerId       String
  previousPersonId String
  newPersonId      String
  reassignedById   String
  reason           String?  @db.Text
  reassignedAt     DateTime @default(now())

  customer       Customer @relation(fields: [customerId], references: [id])
  previousPerson Person   @relation("reassignmentPrevious", fields: [previousPersonId], references: [id])
  newPerson      Person   @relation("reassignmentNew", fields: [newPersonId], references: [id])
  reassignedBy   Account  @relation(fields: [reassignedById], references: [id])

  @@index([customerId])
  @@map("customer_person_reassignments")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  displayName String
  domain      PermissionDomain

  positions PositionPermission[]

  @@map("permissions")
}

model Position {
  id              String  @id @default(uuid())
  organizationId  String
  name            String
  isOwnerPosition Boolean @default(false)

  organization   Organization         @relation(fields: [organizationId], references: [id])
  permissions    PositionPermission[]
  collaborations Collaboration[]

  @@index([organizationId])
  @@map("positions")
}

model PositionPermission {
  positionId   String
  permissionId String

  position   Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([positionId, permissionId])
  @@map("position_permissions")
}

model Collaboration {
  id             String              @id @default(uuid())
  accountId      String
  positionId     String
  organizationId String
  status         CollaborationStatus @default(INVITED)
  invitedAt      DateTime            @default(now())
  acceptedAt     DateTime?

  account      Account      @relation(fields: [accountId], references: [id])
  position     Position     @relation(fields: [positionId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([accountId])
  @@index([organizationId])
  @@map("collaborations")
}

// =====================================================================
// 2. Catalogue et stock (data-model/modele-donnees-livraisons.md §2)
// =====================================================================

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  IN
  OUT
}

model Product {
  id                     String @id @default(uuid())
  businessOrganizationId String
  name                   String
  description            String @db.Text

  // Relationships
  businessOrganization Organization              @relation("ProductBusiness", fields: [businessOrganizationId], references: [id])
  variants             ProductVariant[]
  partnershipProducts  PartnershipProduct[]
  channelRelations     CustomerChannelRelation[]

  @@index([businessOrganizationId])
  @@map("products")
}

model ProductVariant {
  id                    String        @id @default(uuid())
  productId             String
  rangeName             String
  unit                  String
  catalogPrice          Decimal       @db.Decimal(14, 2)
  defaultWholesalePrice Decimal?      @db.Decimal(14, 2)
  status                VariantStatus @default(ACTIVE)

  // Relationships
  product         Product                 @relation(fields: [productId], references: [id])
  stocks          Stock[]
  wholesalePrices ProductWholesalePrice[]
  orderLines      OrderLine[]
  lineChanges     OrderLineChange[]

  @@index([productId])
  @@map("product_variants")
}

model Stock {
  id                String  @id @default(uuid())
  organizationId    String
  productVariantId  String
  quantityAvailable Decimal @db.Decimal(14, 3)
  alertThreshold    Decimal @db.Decimal(14, 3)

  // Relationships
  organization   Organization    @relation(fields: [organizationId], references: [id])
  productVariant ProductVariant  @relation(fields: [productVariantId], references: [id])
  movements      StockMovement[]

  @@unique([organizationId, productVariantId])
  @@index([productVariantId])
  @@map("stocks")
}

model StockMovement {
  id            String            @id @default(uuid())
  stockId       String
  type          StockMovementType
  quantity      Decimal           @db.Decimal(14, 3)
  sourceOrderId String?
  recordedById  String
  note          String?           @db.Text
  date          DateTime          @default(now())

  // Relationships
  stock       Stock   @relation(fields: [stockId], references: [id])
  sourceOrder Order?  @relation("StockMovementSourceOrder", fields: [sourceOrderId], references: [id])
  recordedBy  Account @relation("StockMovementRecordedBy", fields: [recordedById], references: [id])

  @@index([stockId])
  @@index([sourceOrderId])
  @@map("stock_movements")
}

// =====================================================================
// 3. Partenariats et relations commerciales (§3)
// =====================================================================

enum PaymentTerms {
  BEFORE_DELIVERY
  AFTER_COLLECTION
}

enum PartnershipStatus {
  REQUESTED
  ACTIVE
  REFUSED
  TERMINATED
}

enum ChannelType {
  DIRECT
  CONTRACTOR
}

enum ChannelRelationStatus {
  ACTIVE
  SUSPENDED
}

enum ChannelChangeStatus {
  PENDING
  ACCEPTED
  IN_RETENTION
  FREE
}

model PartnershipAgreement {
  id            String            @id @default(uuid())
  businessId    String
  contractorId  String
  paymentTerms  PaymentTerms
  status        PartnershipStatus @default(REQUESTED)
  initiatorId   String
  initiatorNote String?
  recipientNote String?
  createdAt     DateTime          @default(now())
  refusedAt     DateTime?
  terminatedAt  DateTime?

  // Relationships
  business   Organization         @relation("AgreementBusiness", fields: [businessId], references: [id])
  contractor Organization         @relation("AgreementContractor", fields: [contractorId], references: [id])
  initiator  Organization         @relation("AgreementInitiator", fields: [initiatorId], references: [id])
  products   PartnershipProduct[]

  @@index([businessId])
  @@index([contractorId])
  @@map("partnership_agreements")
}

model PartnershipProduct {
  id                      String            @id @default(uuid())
  agreementId             String
  productId               String
  status                  PartnershipStatus @default(REQUESTED)
  initiatorId             String
  initiatorNote           String?
  recipientNote           String?
  addedAt                 DateTime          @default(now())
  refusedAt               DateTime?
  terminatedAt            DateTime?
  terminationStockCleared Boolean           @default(false)

  // Relationships
  agreement       PartnershipAgreement    @relation(fields: [agreementId], references: [id])
  product         Product                 @relation(fields: [productId], references: [id])
  initiator       Organization            @relation("PartnershipProductInitiator", fields: [initiatorId], references: [id])
  wholesalePrices ProductWholesalePrice[]

  @@unique([agreementId, productId])
  @@index([productId])
  @@map("partnership_products")
}

model ProductWholesalePrice {
  id                   String  @id @default(uuid())
  partnershipProductId String
  productVariantId     String
  wholesalePrice       Decimal @db.Decimal(14, 2)

  // Relationships
  partnershipProduct PartnershipProduct @relation(fields: [partnershipProductId], references: [id])
  productVariant     ProductVariant     @relation(fields: [productVariantId], references: [id])

  @@index([partnershipProductId])
  @@index([productVariantId])
  @@map("product_wholesale_prices")
}

// NOTE: the partial unique index on (personId, businessId, productId) WHERE
// status = 'ACTIVE' (§3.4 exclusivity rule) cannot be expressed in the Prisma
// schema DSL without the `extendedIndexes` preview feature (not enabled in
// this project). It is added by hand to the generated migration.sql — see
// the plan / research notes for this change.
model CustomerChannelRelation {
  id           String                @id @default(uuid())
  personId     String
  businessId   String
  productId    String
  channelType  ChannelType
  contractorId String?
  status       ChannelRelationStatus @default(ACTIVE)
  startedAt    DateTime              @default(now())

  // Relationships
  person         Person                 @relation(fields: [personId], references: [id])
  business       Organization           @relation("ChannelRelationBusiness", fields: [businessId], references: [id])
  product        Product                @relation(fields: [productId], references: [id])
  contractor     Organization?          @relation("ChannelRelationContractor", fields: [contractorId], references: [id])
  changeRequests ChannelChangeRequest[]
  orders         Order[]

  @@index([personId])
  @@index([businessId, productId])
  @@index([contractorId])
  @@map("customer_channel_relations")
}

model ChannelChangeRequest {
  id                String              @id @default(uuid())
  currentRelationId String
  newChannelType    ChannelType
  newContractorId   String?
  status            ChannelChangeStatus @default(PENDING)
  requestedAt       DateTime            @default(now())
  retentionEndAt    DateTime?

  // Relationships
  currentRelation CustomerChannelRelation @relation(fields: [currentRelationId], references: [id])
  newContractor   Organization?           @relation("ChannelChangeNewContractor", fields: [newContractorId], references: [id])

  @@index([currentRelationId])
  @@map("channel_change_requests")
}

// =====================================================================
// 4. Commandes et livraisons (§4)
// =====================================================================

enum OrderStatus {
  PENDING
  PENDING_STOCK
  CONFIRMED
  IN_DELIVERY
  PARTIALLY_DELIVERED
  DELIVERED
  FAILED
  CANCELLED
}

enum EntryMode {
  SELF_SERVICE
  ASSISTED
}

enum OrderLineChangeType {
  LINE_ADDED
  LINE_REMOVED
  QUANTITY_UPDATED
}

// NOTE: issuerId is a polymorphic reference (Person or Organization,
// discriminated by issuerType) with no Prisma-level FK, per §4.1's explicit
// "discriminant léger" design — referential integrity there stays
// application-level, matching the source document. CHECK constraints for the
// desired-slot pairing (date required, start/end paired, end > start) are
// added by hand to the generated migration.sql.
model Order {
  id                   String      @id @default(uuid())
  issuerType           PartyType
  issuerId             String
  recipientId          String
  channelRelationId    String?
  totalAmount          Decimal     @db.Decimal(14, 2)
  deliveryCost         Decimal     @default(0) @db.Decimal(14, 2)
  status               OrderStatus @default(PENDING)
  createdAt            DateTime    @default(now())
  desiredDeliveryDate  DateTime?   @db.Date
  desiredSlotStart     DateTime?   @db.Time
  desiredSlotEnd       DateTime?   @db.Time
  cancellationDeadline DateTime?
  cancellationFee      Decimal?    @db.Decimal(14, 2)
  entryMode            EntryMode   @default(SELF_SERVICE)
  enteredById          String?
  parentOrderId        String?
  issuerNote           String?
  recipientNote        String?

  // Relationships
  recipient          Organization             @relation("OrderRecipient", fields: [recipientId], references: [id])
  channelRelation    CustomerChannelRelation? @relation(fields: [channelRelationId], references: [id])
  enteredBy          Account?                 @relation("OrderEnteredBy", fields: [enteredById], references: [id])
  parentOrder        Order?                   @relation("OrderParent", fields: [parentOrderId], references: [id])
  childOrders        Order[]                  @relation("OrderParent")
  lines              OrderLine[]
  lineChanges        OrderLineChange[]
  delivery           Delivery?
  payments           Payment[]
  debts              Debt[]
  refunds            Refund[]
  receipt            Receipt?
  ratings            Rating[]
  operatingCostLinks OperatingCostOrderLink[]
  stockMovements     StockMovement[]          @relation("StockMovementSourceOrder")

  @@index([issuerType, issuerId])
  @@index([recipientId])
  @@index([channelRelationId])
  @@index([parentOrderId])
  @@index([status])
  @@map("orders")
}

model OrderLine {
  id                String   @id @default(uuid())
  orderId           String
  productVariantId  String
  quantity          Decimal  @db.Decimal(14, 3)
  deliveredQuantity Decimal? @db.Decimal(14, 3)
  unitPriceApplied  Decimal  @db.Decimal(14, 2)

  // Relationships
  order          Order          @relation(fields: [orderId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_lines")
}

model OrderLineChange {
  id               String              @id @default(uuid())
  orderId          String
  changedById      String
  changeType       OrderLineChangeType
  productVariantId String
  previousQuantity Decimal?            @db.Decimal(14, 3)
  newQuantity      Decimal?            @db.Decimal(14, 3)
  changedAt        DateTime            @default(now())

  // Relationships
  order          Order          @relation(fields: [orderId], references: [id])
  changedBy      Account        @relation("OrderLineChangeChangedBy", fields: [changedById], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@map("order_line_changes")
}

model Delivery {
  id              String    @id @default(uuid())
  orderId         String    @unique
  assignedToId    String?
  amountToCollect Decimal   @db.Decimal(14, 2)
  amountCollected Decimal?  @db.Decimal(14, 2)
  departureLat    Decimal?  @db.Decimal(9, 6)
  departureLng    Decimal?  @db.Decimal(9, 6)
  departedAt      DateTime?
  arrivalLat      Decimal?  @db.Decimal(9, 6)
  arrivalLng      Decimal?  @db.Decimal(9, 6)
  arrivedAt       DateTime?

  // Relationships
  order      Order    @relation(fields: [orderId], references: [id])
  assignedTo Account? @relation("DeliveryAssignedTo", fields: [assignedToId], references: [id])

  @@index([assignedToId])
  @@map("deliveries")
}

// =====================================================================
// 5. Finances (§5)
// =====================================================================

enum PaymentMode {
  MOBILE_MONEY
  MANUAL_CASH
}

enum DebtStatus {
  OUTSTANDING
  SETTLED
}

enum AllocationMode {
  AUTOMATIC
  MANUAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

// NOTE: payerId is polymorphic (Person or Organization); CHECK (amount > 0)
// and CHECK (amountAllocated <= amount) are added by hand to the generated
// migration.sql (§5.1).
model Payment {
  id                   String      @id @default(uuid())
  orderId              String?
  payerType            PartyType
  payerId              String
  creditorId           String
  amount               Decimal     @db.Decimal(14, 2)
  amountAllocated      Decimal     @default(0) @db.Decimal(14, 2)
  mode                 PaymentMode
  transactionReference String?
  recordedById         String
  remittedAt           DateTime?
  note                 String?     @db.Text
  date                 DateTime    @default(now())

  // Relationships
  order       Order?           @relation(fields: [orderId], references: [id])
  creditor    Organization     @relation("PaymentCreditor", fields: [creditorId], references: [id])
  recordedBy  Account          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  settlements DebtSettlement[]

  @@index([orderId])
  @@index([payerType, payerId])
  @@index([creditorId])
  @@index([recordedById])
  @@map("payments")
}

// NOTE: debtorId is polymorphic (Person or Organization); CHECK
// (amountSettled <= amountDue) is added by hand to the generated
// migration.sql (§5.2).
model Debt {
  id            String     @id @default(uuid())
  orderId       String
  debtorType    PartyType
  debtorId      String
  creditorId    String
  amountDue     Decimal    @db.Decimal(14, 2)
  amountSettled Decimal    @default(0) @db.Decimal(14, 2)
  createdAt     DateTime   @default(now())
  recordedById  String?
  note          String?    @db.Text
  status        DebtStatus @default(OUTSTANDING)

  // Relationships
  order       Order            @relation(fields: [orderId], references: [id])
  creditor    Organization     @relation("DebtCreditor", fields: [creditorId], references: [id])
  recordedBy  Account?         @relation("DebtRecordedBy", fields: [recordedById], references: [id])
  settlements DebtSettlement[]
  refunds     Refund[]

  @@index([orderId])
  @@index([debtorType, debtorId])
  @@index([creditorId])
  @@index([status])
  @@map("debts")
}

// NOTE: rows are immutable (§5.3 — corrections happen via a reversing row,
// never an update/delete). A BEFORE UPDATE OR DELETE trigger raising an
// exception, plus CHECK (reversesSettlementId IS NOT NULL) = (amountAllocated
// < 0), are added by hand to the generated migration.sql.
model DebtSettlement {
  id                   String         @id @default(uuid())
  debtId               String
  paymentId            String
  amountAllocated      Decimal        @db.Decimal(14, 2)
  allocationMode       AllocationMode
  reversesSettlementId String?
  recordedById         String?
  note                 String?        @db.Text
  date                 DateTime       @default(now())

  // Relationships
  debt               Debt             @relation(fields: [debtId], references: [id])
  payment            Payment          @relation(fields: [paymentId], references: [id])
  reversesSettlement DebtSettlement?  @relation("SettlementReversal", fields: [reversesSettlementId], references: [id])
  reversedBy         DebtSettlement[] @relation("SettlementReversal")
  recordedBy         Account?         @relation("DebtSettlementRecordedBy", fields: [recordedById], references: [id])

  @@index([debtId])
  @@index([paymentId])
  @@map("debt_settlements")
}

// NOTE: beneficiaryId is polymorphic (Person or Organization); CHECK
// (amount > 0) is added by hand to the generated migration.sql (§5.4).
model Refund {
  id                   String      @id @default(uuid())
  orderId              String?
  beneficiaryType      PartyType
  beneficiaryId        String
  organizationId       String
  amount               Decimal     @db.Decimal(14, 2)
  mode                 PaymentMode
  transactionReference String?
  relatedDebtId        String?
  recordedById         String
  note                 String?     @db.Text
  date                 DateTime    @default(now())

  // Relationships
  order        Order?       @relation(fields: [orderId], references: [id])
  organization Organization @relation("RefundOrganization", fields: [organizationId], references: [id])
  relatedDebt  Debt?        @relation(fields: [relatedDebtId], references: [id])
  recordedBy   Account      @relation("RefundRecordedBy", fields: [recordedById], references: [id])

  @@index([orderId])
  @@index([beneficiaryType, beneficiaryId])
  @@index([organizationId])
  @@index([relatedDebtId])
  @@map("refunds")
}

model DebtCeiling {
  id         String    @id @default(uuid())
  creditorId String
  debtorType PartyType
  maxAmount  Decimal   @db.Decimal(14, 2)

  // Relationships
  creditor Organization @relation(fields: [creditorId], references: [id])

  @@index([creditorId])
  @@map("debt_ceilings")
}

model Receipt {
  id            String   @id @default(uuid())
  orderId       String   @unique
  generatedById String
  generatedAt   DateTime @default(now())
  fileUrl       String

  // Relationships
  order       Order   @relation(fields: [orderId], references: [id])
  generatedBy Account @relation("ReceiptGeneratedBy", fields: [generatedById], references: [id])

  @@map("receipts")
}

model Subscription {
  id         String             @id @default(uuid())
  businessId String
  plan       String
  status     SubscriptionStatus @default(ACTIVE)
  startsAt   DateTime
  endsAt     DateTime

  // Relationships
  business Organization @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@map("subscriptions")
}

model OperatingCostCategory {
  id             String  @id @default(uuid())
  name           String
  organizationId String?

  // Relationships
  organization Organization?   @relation(fields: [organizationId], references: [id])
  costs        OperatingCost[]

  @@index([organizationId])
  @@map("operating_cost_categories")
}

model OperatingCost {
  id             String   @id @default(uuid())
  organizationId String
  categoryId     String
  amount         Decimal  @db.Decimal(14, 2)
  description    String?  @db.Text
  recordedById   String
  date           DateTime @default(now())

  // Relationships
  organization Organization             @relation(fields: [organizationId], references: [id])
  category     OperatingCostCategory    @relation(fields: [categoryId], references: [id])
  recordedBy   Account                  @relation("OperatingCostRecordedBy", fields: [recordedById], references: [id])
  orderLinks   OperatingCostOrderLink[]

  @@index([organizationId])
  @@index([categoryId])
  @@map("operating_costs")
}

model OperatingCostOrderLink {
  operatingCostId String
  orderId         String

  // Relationships
  operatingCost OperatingCost @relation(fields: [operatingCostId], references: [id])
  order         Order         @relation(fields: [orderId], references: [id])

  @@id([operatingCostId, orderId])
  @@map("operating_cost_order_links")
}

// =====================================================================
// 6. Partage d'informations (§6)
// =====================================================================

enum SharingDefaultRule {
  SHARE
  DO_NOT_SHARE
}

model InfoSharingRule {
  id           String             @id @default(uuid())
  contractorId String
  businessId   String
  defaultRule  SharingDefaultRule
  updatedAt    DateTime           @updatedAt

  // Relationships
  contractor Organization               @relation("InfoSharingContractor", fields: [contractorId], references: [id])
  business   Organization               @relation("InfoSharingBusiness", fields: [businessId], references: [id])
  exceptions CustomerSharingException[]

  @@unique([contractorId, businessId])
  @@map("info_sharing_rules")
}

model CustomerSharingException {
  id         String  @id @default(uuid())
  ruleId     String
  customerId String
  share      Boolean

  // Relationships
  rule     InfoSharingRule @relation(fields: [ruleId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])

  @@unique([ruleId, customerId])
  @@map("customer_sharing_exceptions")
}

// =====================================================================
// 7. Réputation et modération (§7)
// =====================================================================

enum ReportStatus {
  PENDING
  RESOLVED
}

enum ReportDecision {
  DISMISSED
  SUSPENSION
}

// NOTE: CHECK requiring Person.phoneVerifiedAt IS NOT NULL (§7.1,
// anti-self-review) spans two tables and cannot be a plain column CHECK in
// Postgres — implemented as a BEFORE INSERT trigger added by hand to the
// generated migration.sql.
model Rating {
  id              String   @id @default(uuid())
  personId        String
  contractorId    String
  orderId         String
  score           Int
  comment         String?  @db.Text
  date            DateTime @default(now())
  publiclyVisible Boolean  @default(true)

  // Relationships
  person     Person       @relation(fields: [personId], references: [id])
  contractor Organization @relation("RatingContractor", fields: [contractorId], references: [id])
  order      Order        @relation(fields: [orderId], references: [id])

  @@index([contractorId])
  @@index([orderId])
  @@map("ratings")
}

// NOTE: targetId is polymorphic (Person or Organization), no Prisma-level FK
// (§7.2), matching the "target_type/target_id" discriminant design.
model Report {
  id           String          @id @default(uuid())
  reporterId   String
  targetType   PartyType
  targetId     String
  reason       String
  description  String          @db.Text
  status       ReportStatus    @default(PENDING)
  resolvedById String?
  decision     ReportDecision?
  reportedAt   DateTime        @default(now())
  resolvedAt   DateTime?

  // Relationships
  reporter   Account        @relation("ReportReporter", fields: [reporterId], references: [id])
  resolvedBy Administrator? @relation("ReportResolvedBy", fields: [resolvedById], references: [id])

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

// =====================================================================
// 8. Gouvernance de la plateforme (§8)
// =====================================================================

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
}

model Administrator {
  id          String    @id @default(uuid())
  accountId   String    @unique
  role        AdminRole
  appointedAt DateTime  @default(now())

  // Relationships
  account         Account  @relation(fields: [accountId], references: [id])
  reportsResolved Report[] @relation("ReportResolvedBy")

  @@map("administrators")
}

// =====================================================================
// 9. Notifications (§9)
// =====================================================================

enum NotificationChannel {
  IN_APP
  SMS
}

enum ReadStatus {
  UNREAD
  READ
}

// NOTE: relatedEntityId is a polymorphic reference (no Prisma-level FK),
// consistent with Report.targetId (§9.1). CHECK ensuring relatedEntityType
// and relatedEntityId are set together or both null is added by hand to the
// generated migration.sql.
model Notification {
  id                String              @id @default(uuid())
  recipientId       String
  organizationId    String?
  channel           NotificationChannel
  content           String              @db.Text
  sourceEvent       String
  relatedEntityType String?
  relatedEntityId   String?
  readStatus        ReadStatus          @default(UNREAD)
  date              DateTime            @default(now())

  // Relationships
  recipient    Person        @relation(fields: [recipientId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([recipientId, readStatus])
  @@index([organizationId])
  @@map("notifications")
}

// =====================================================================
// 10. Synchronisation offline (§10) — PendingAction (10.1) is described as a
// local, client-side queue (its id is generated by the client) and is
// intentionally NOT modelled here. Only the server-side idempotency
// registry, ProcessedAction (10.2), is part of this schema.
// =====================================================================

model ProcessedAction {
  accountId       String
  pendingActionId String
  actionType      String
  entityType      String
  entityId        String
  processedAt     DateTime @default(now())

  // Relationships
  account Account @relation(fields: [accountId], references: [id])

  @@id([accountId, pendingActionId])
  @@map("processed_actions")
}
