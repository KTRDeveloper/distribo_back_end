// Prisma schema for Node.js template project
// See data-model.md for detailed entity specifications

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum TaskStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// Task model for background jobs
model Task {
  id           String     @id @default(uuid())
  type         String
  accountId    String
  parameters   Json
  status       TaskStatus @default(QUEUED)
  priority     Int        @default(0)
  progress     Int        @default(0)
  errorMessage String?
  retryCount   Int        @default(0)
  submittedAt  DateTime   @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  result  TaskResult?

  @@index([accountId, status])
  @@index([status, submittedAt])
  @@index([completedAt])
  @@map("tasks")
}

// Task result model
model TaskResult {
  id          String   @id @default(uuid())
  taskId      String   @unique
  outputPath  String
  metadata    Json
  storageSize BigInt
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  // Relationships
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("task_results")
}

// Phone/OTP authentication (002-sms-otp-auth): superseded PasswordResetToken
// (email-link reset, never fully wired) with OTP-based sign-in and reset.

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

enum OtpChannel {
  SMS
  EMAIL
}
