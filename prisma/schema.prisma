// Prisma schema for Node.js template project

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Task {
  id           String     @id @default(uuid())
  type         String
  accountId    String
  parameters   Json
  status       TaskStatus @default(QUEUED)
  priority     Int        @default(0)
  progress     Int        @default(0)
  errorMessage String?
  retryCount   Int        @default(0)
  submittedAt  DateTime   @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  result  TaskResult?

  @@index([accountId, status])
  @@index([status, submittedAt])
  @@index([completedAt])
  @@map("tasks")
}

model TaskResult {
  id          String   @id @default(uuid())
  taskId      String   @unique
  outputPath  String
  metadata    Json
  storageSize BigInt
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("task_results")
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

enum OtpChannel {
  SMS
  EMAIL
}

enum Language {
  FR
  EN
}

enum PersonStatus {
  ACTIVE
  SUSPENDED
  ANONYMIZED
}

model OtpChallenge {
  id         String     @id @default(uuid())
  accountId  String
  purpose    OtpPurpose
  channel    OtpChannel @default(SMS)
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model EmailVerificationRequest {
  id          String    @id @default(uuid())
  accountId   String
  email       String
  codeHash    String
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, confirmedAt])
  @@index([expiresAt])
  @@map("email_verification_requests")
}

enum RefreshTokenRevokedReason {
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  PASSWORD_RESET
  ACCOUNT_LOCKED
}

model RefreshToken {
  id            String                     @id @default(uuid())
  accountId     String
  tokenHash     String                     @unique
  expiresAt     DateTime
  createdAt     DateTime                   @default(now())
  rotatedAt     DateTime?
  revokedAt     DateTime?
  revokedReason RefreshTokenRevokedReason?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model SystemConfig {
  id               String    @id @default(uuid())
  category         String
  key              String
  value            String    @db.Text
  isSensitive      Boolean   @default(false)
  isProtected      Boolean   @default(false)
  enabled          Boolean   @default(true)
  description      String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  lastValidatedAt  DateTime?
  validationStatus String?
  validationError  String?   @db.Text

  history ConfigHistory[]

  @@unique([category, key])
  @@index([category])
  @@index([category, enabled])
  @@index([updatedAt])
  @@map("system_config")
}

model ConfigHistory {
  id            String   @id @default(uuid())
  configId      String
  action        String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  changedAt     DateTime @default(now())
  changedBy     String?
  reason        String?  @db.Text

  config SystemConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([changedAt])
  @@index([changedBy])
  @@map("config_history")
}

model Person {
  id                String       @id @default(uuid())
  fullName          String?
  phoneNumber       String       @unique
  phoneVerifiedAt   DateTime?
  email             String?      @unique
  emailVerifiedAt   DateTime?
  preferredLanguage Language?
  createdAt         DateTime     @default(now())
  status            PersonStatus @default(ACTIVE)
  anonymizedAt      DateTime?

  account Account?

  @@map("people")
}

model Account {
  id                  String    @id @default(uuid())
  personId            String    @unique
  passwordHash        String
  passwordChangedAt   DateTime  @default(now())
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  person                    Person                     @relation(fields: [personId], references: [id])
  tasks                     Task[]
  otpChallenges             OtpChallenge[]
  emailVerificationRequests EmailVerificationRequest[]
  refreshTokens             RefreshToken[]

  @@index([lockedUntil])
  @@index([deletedAt])
  @@map("accounts")
}
