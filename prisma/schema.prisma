// Prisma schema for Node.js template project
//
// Some rules live only in the database, because Prisma has no way to declare
// them. They are written in the SQL migrations, and each model below that has
// such rules explains them in a comment just above it (see CLAUDE.md).
//
// Rules shared by several tables:
// - The application connects as a limited database user, distribo_app. It can
//   read, add, change and delete rows in every table, except where a table
//   says otherwise below. (Migration 20260930220000_app_role_and_server_time)
// - On tables that have a server_updated_at column, the database itself sets
//   that column to the current server time whenever a row is added or changed.
//   Any value sent by the application is ignored.
//   (Migration 20260930220000_app_role_and_server_time)
// - Some tables refuse to point at a person who has not finished registering.
//   The database checks this itself; the tables concerned say so below.
//   (Migration 20261003091410_per_008_registered_person_guard)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Task {
  id           String     @id @default(uuid())
  type         String
  accountId    String     @map("account_id") @db.Uuid
  parameters   Json
  status       TaskStatus @default(QUEUED)
  priority     Int        @default(0)
  progress     Int        @default(0)
  errorMessage String?
  retryCount   Int        @default(0)
  submittedAt  DateTime   @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  person Person      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  result TaskResult?

  @@index([accountId, status])
  @@index([status, submittedAt])
  @@index([completedAt])
  @@map("tasks")
}

model TaskResult {
  id          String   @id @default(uuid())
  taskId      String   @unique
  outputPath  String
  metadata    Json
  storageSize BigInt
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("task_results")
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
  PHONE_CHANGE
  EMAIL_VERIFICATION
  TOTP_RECOVERY
}

enum OtpChannel {
  SMS
  EMAIL
}

enum Language {
  FR
  EN
}

enum PersonStatus {
  ACTIVE
  SUSPENDED
  ANONYMIZED
}

enum RefreshTokenRevokedReason {
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  PASSWORD_RESET
  ACCOUNT_LOCKED
  DEVICE_REMOVED
  ACCOUNT_SUSPENDED
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum NotificationReadStatus {
  UNREAD
  READ
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CollaborationRole {
  OWNER
  MANAGER
  SELLER
  DRIVER
}

enum CollaborationStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum RelationshipStatus {
  PENDING
  ACTIVE
  ENDED
}

enum RelationshipParty {
  CUSTOMER
  SUPPLIER
}

enum AdministratorRole {
  SUPER_ADMIN
  MODERATOR
}

enum AdminActionType {
  SUSPEND
  REACTIVATE
  DISMISS_REPORT
  APPOINT_ADMIN
  REMOVE_ADMIN
  REPLAY_SYNC
  RECOVER_2FA
}

enum ReportStatus {
  PENDING
  RESOLVED
}

enum ReportDecision {
  DISMISSED
  SUSPENSION
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
}

enum OrderParty {
  CUSTOMER
  SUPPLIER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_DELIVERY
  DELIVERED
  CANCELLED
}

enum LedgerEntryKind {
  SALE
  PAYMENT
  REFUND
  CREDIT_NOTE
  OPENING_BALANCE
}

enum LedgerEntryMode {
  CASH
  MOBILE_MONEY
}

model SystemConfig {
  id               String    @id @default(uuid())
  category         String
  key              String
  value            String    @db.Text
  isSensitive      Boolean   @default(false)
  isProtected      Boolean   @default(false)
  enabled          Boolean   @default(true)
  description      String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  lastValidatedAt  DateTime?
  validationStatus String?
  validationError  String?   @db.Text

  history ConfigHistory[]

  @@unique([category, key])
  @@index([category])
  @@index([category, enabled])
  @@index([updatedAt])
  @@map("system_config")
}

model ConfigHistory {
  id            String   @id @default(uuid())
  configId      String
  action        String
  previousValue String?  @db.Text
  newValue      String?  @db.Text
  changedAt     DateTime @default(now())
  changedBy     String?
  reason        String?  @db.Text

  config SystemConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([changedAt])
  @@index([changedBy])
  @@map("config_history")
}

// Rules the database enforces on people, beyond what this model declares:
// - Two people cannot share the same verified email, whatever the upper or
//   lower case. Unverified emails may repeat, which is why email is not marked
//   @unique here. (Migration 20261002060000_per_003_person_checks)
// - Phone numbers are stored in international format: a "+", then 8 to 15
//   digits, the first not 0. (Migration 20261002060000_per_003_person_checks)
// - A person always has exactly one number: either a current phone_number or,
//   once they gave it up, the released_phone_number.
//   (Migration 20261002060000_per_003_person_checks)
// - An anonymized person keeps no current phone number.
//   (Migration 20261002060000_per_003_person_checks)
// - A phone can only be marked verified while the person has a current number.
//   (Migration 20261002060000_per_003_person_checks)
// - A registered person, unless anonymized, must have a real name and a
//   password, and their current phone number, if any, must be verified. Text
//   made only of spaces, of any kind, counts as empty.
//   (Migration 20261003061000_fnd_011_person_unicode_whitespace)
// - An email can only be marked verified if there is an email, not just spaces.
//   (Migration 20261003061000_fnd_011_person_unicode_whitespace)
// - server_updated_at is set by the database on every change.
//   (Migration 20261002051743_per_002_person_v10)
// - When a person's phone number is removed, they stop being the public
//   contact of every organization they belong to.
//   (Migration 20261004110000_org_003_collaborations)
model Person {
  id                  String         @id @db.Uuid
  otpChallenges       OtpChallenge[]
  devices             Device[]
  refreshTokens       RefreshToken[]
  fullName            String?        @map("full_name")
  phoneNumber         String?        @unique @map("phone_number")
  releasedPhoneNumber String?        @map("released_phone_number")
  phoneVerifiedAt     DateTime?      @map("phone_verified_at")
  email               String?
  emailVerifiedAt     DateTime?      @map("email_verified_at")
  passwordHash        String?        @map("password_hash")
  registeredAt        DateTime?      @map("registered_at")
  preferredLanguage   Language?      @map("preferred_language")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  status              PersonStatus   @default(ACTIVE)
  anonymizedAt        DateTime?      @map("anonymized_at")
  serverUpdatedAt     DateTime       @default(now()) @map("server_updated_at") @db.Timestamptz
  scopeVersion        Int            @default(0) @map("scope_version")

  tasks                 Task[]
  phoneNumberChangeLogs PhoneNumberChangeLog[]
  idempotencyKeys       IdempotencyKey[]
  notifications         Notification[]
  collaborations        Collaboration[]

  suppliedRelationships   CustomerRelationship[] @relation("RelationshipSupplierPerson")
  customerRelationships   CustomerRelationship[] @relation("RelationshipCustomerPerson")
  creditLimitSetRelations CustomerRelationship[] @relation("RelationshipCreditLimitSetBy")
  createdRelationships    CustomerRelationship[] @relation("RelationshipCreatedBy")
  creditLimitChanges      CreditLimitChange[]

  reassignmentsFrom CustomerRelationshipReassignment[] @relation("ReassignmentPreviousPerson")
  reassignmentsTo   CustomerRelationshipReassignment[] @relation("ReassignmentNewPerson")
  reassignmentsMade CustomerRelationshipReassignment[] @relation("ReassignmentAuthor")

  customerPricesSet CustomerPrice[] @relation("CustomerPriceSetBy")

  ordersEntered    Order[]     @relation("OrderEnteredBy")
  ordersDelivered  Order[]     @relation("OrderDeliveredBy")
  ordersCancelled  Order[]     @relation("OrderCancelledBy")
  orderLinesPriced OrderLine[] @relation("OrderLinePriceSetBy")

  deliveriesAssigned Delivery[] @relation("DeliveryAssignedTo")

  ledgerEntriesRecorded LedgerEntry[] @relation("LedgerEntryRecordedBy")

  expensesPaid      Expense[] @relation("ExpensePaidBy")
  expensesRecorded  Expense[] @relation("ExpenseRecordedBy")
  expensesCancelled Expense[] @relation("ExpenseCancelledBy")

  handoversSent      Handover[] @relation("HandoverFrom")
  handoversReceived  Handover[] @relation("HandoverTo")
  handoversCancelled Handover[] @relation("HandoverCancelledBy")

  administrators Administrator[]

  adminActionsAsTarget AdminAction[] @relation("AdminActionTargetPerson")

  reportsFiled          Report[] @relation("ReportReporter")
  reportsAsTargetPerson Report[] @relation("ReportTargetPerson")

  @@map("people")
}

// Rules the database enforces on notifications, beyond what this model declares:
// - A notification either points to a related item (both its type and its id
//   are filled) or to nothing (both empty), never half of it.
//   (Migration 20261003122500_ntf_001_notifications)
// - The message text is required, not just spaces, and at most 2000
//   characters. (Migration 20261003134000_ntf_002_notify_validation)
// - The event name is at most 100 characters, in lowercase words joined by
//   dots, for example "order.created".
//   (Migration 20261003134000_ntf_002_notify_validation)
// - The related item type, when given, is not just spaces and is at most 100
//   characters. (Migration 20261003134000_ntf_002_notify_validation)
// - The recipient must be a registered person. This is checked when the
//   transaction is saved, not row by row.
//   (Migration 20261003122500_ntf_001_notifications)
// - server_updated_at is set by the database on every change.
//   (Migration 20261003122500_ntf_001_notifications)
model Notification {
  id                String                 @id @db.Uuid
  recipientId       String                 @map("recipient_id") @db.Uuid
  organizationId    String?                @map("organization_id") @db.Uuid
  content           String                 @db.Text
  sourceEvent       String                 @map("source_event")
  relatedEntityType String?                @map("related_entity_type")
  relatedEntityId   String?                @map("related_entity_id") @db.Uuid
  readStatus        NotificationReadStatus @default(UNREAD) @map("read_status")
  pushedAt          DateTime?              @map("pushed_at") @db.Timestamptz
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  serverUpdatedAt   DateTime               @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt         DateTime?              @map("deleted_at") @db.Timestamptz

  recipient    Person        @relation(fields: [recipientId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([recipientId, readStatus, createdAt(sort: Desc)])
  @@map("notifications")
}

// Rule the database enforces on organizations, beyond what this model declares:
// - server_updated_at is set by the database on every change.
//   (Migration 20261004090000_org_001_organizations)
model Organization {
  id              String             @id @db.Uuid
  name            String
  description     String?            @db.Text
  email           String?
  status          OrganizationStatus @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  serverUpdatedAt DateTime           @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz

  notifications  Notification[]
  collaborations Collaboration[]
  subscriptions  Subscription[]

  products  Product[]
  expenses  Expense[]
  handovers Handover[]

  suppliedRelationships CustomerRelationship[] @relation("RelationshipSupplierOrganization")
  customerRelationships CustomerRelationship[] @relation("RelationshipCustomerOrganization")

  adminActionsAsTarget AdminAction[] @relation("AdminActionTargetOrganization")

  reportsAsTarget Report[] @relation("ReportTargetOrganization")

  @@map("organizations")
}

// Rule the database enforces on subscriptions (the billing history of an
// organization), beyond what this model declares. It comes from migration
// 20261004120000_org_012_subscriptions.
// - An organization has at most one active subscription. Expired ones stay as
//   history, so several can exist. The exception for expired rows is why this
//   rule is not written as @@unique here.
// Subscriptions are not synchronized to phones, so there is no
// server_updated_at or deleted_at column.
model Subscription {
  id             String             @id @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  plan           String
  status         SubscriptionStatus
  startsAt       DateTime?          @map("starts_at") @db.Timestamptz
  endsAt         DateTime?          @map("ends_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("subscriptions")
}

// Rules the database enforces on collaborations (a person's membership in an
// organization), beyond what this model declares. All come from migration
// 20261004110000_org_003_collaborations.
// - A person has at most one membership per organization. A deleted membership
//   does not count, so someone who was removed can be invited again. That
//   exception is why this rule is not written as @@unique here.
// - An organization has exactly one active owner. Deleted memberships do not
//   count. This is checked when the transaction is saved, so the owner must be
//   added in the same transaction as the organization's first membership, and
//   a change of owner must happen within a single transaction.
// - Only a registered person can have an active membership.
// - A member can be the organization's public contact only while their
//   membership is active and they have a current phone number. If they lose
//   their phone number, they stop being the public contact automatically.
// - server_updated_at is set by the database on every change.
model Collaboration {
  id              String              @id @db.Uuid
  personId        String              @map("person_id") @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  role            CollaborationRole
  status          CollaborationStatus
  isPublicContact Boolean             @default(false) @map("is_public_contact")
  invitedAt       DateTime            @default(now()) @map("invited_at") @db.Timestamptz
  acceptedAt      DateTime?           @map("accepted_at") @db.Timestamptz
  amountHeld      BigInt              @default(0) @map("amount_held")
  serverUpdatedAt DateTime            @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz

  person       Person       @relation(fields: [personId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("collaborations")
}

// Rules the database enforces on customer relationships (the commercial link
// between a supplier and a customer), beyond what this model declares. The
// first two come from migration 20261004130000_rel_001_relationships, the rest
// from 20261004140000_rel_002_party_rules, the credit rules from
// 20261004270000_rel_004_credit_limit_rules.
// - The person who created the relationship, and the person who set the credit
//   limit, must be registered people, never guests. This is checked when the
//   transaction is saved, not row by row.
// - server_updated_at is set by the database on every change.
// - A relationship has exactly one supplier (an organization or a person) and
//   at most one customer (a person or an organization). With no customer it is
//   a counter, and then customer_label must be filled in. Once the customer
//   person is known, customer_phone_number must be empty. An organization can
//   never be both supplier and customer of the same relationship.
// - Only one live relationship may exist per supplier and customer pair.
//   Deleted rows and rows merged into another do not count. This is four
//   partial unique indexes (one per supplier/customer column pair) that Prisma
//   cannot express, so code must not rely on a Prisma unique lookup; catch the
//   unique violation (23505) instead. Counters have no customer id, so one
//   organization may have many.
// - A row that was merged into another (merged_into_id) must also be deleted.
// - The status is PENDING exactly when the supplier is a person (an invitation
//   from a customer); an organization supplier is never PENDING.
// - ended_by_party is filled in exactly when the status is ENDED.
// - A new relationship starts with a credit limit of 0 (no credit). An empty
//   limit means "no ceiling" and is allowed for a customer. A counter (no
//   customer) always has a limit of exactly 0. A limit is never negative.
// - credit_limit_set_by_id and credit_limit_set_at are both filled in or both
//   empty.
// - A limit can only change together with credit_limit_set_by_id: an update
//   that changes the limit but not its author is refused. The database sets
//   credit_limit_set_at to the server time itself and writes one
//   credit_limit_changes row (old limit, new limit, author, time) in the same
//   transaction, so code never writes that journal row and cannot skip it.
//   This also refuses the same person changing the limit twice in a row, so
//   when the caller is already the recorded author the code first blanks
//   author and time (together), then writes the new limit and author, all in
//   one transaction under a row lock (relationship.repository writeCreditLimit).
//   Setting the same value again changes nothing and writes nothing. The
//   default of 0 is also applied by the database on insert; an insert that
//   supplies a limit directly is not journaled (it is creation, not a change).
model CustomerRelationship {
  id                     String             @id @db.Uuid
  supplierOrganizationId String?            @map("supplier_organization_id") @db.Uuid
  supplierPersonId       String?            @map("supplier_person_id") @db.Uuid
  customerPersonId       String?            @map("customer_person_id") @db.Uuid
  customerOrganizationId String?            @map("customer_organization_id") @db.Uuid
  customerPhoneNumber    String?            @map("customer_phone_number")
  customerLabel          String?            @map("customer_label")
  supplierLabel          String?            @map("supplier_label")
  deliveryAddress        String?            @map("delivery_address")
  creditLimit            BigInt?            @default(0) @map("credit_limit")
  creditLimitSetById     String?            @map("credit_limit_set_by_id") @db.Uuid
  creditLimitSetAt       DateTime?          @map("credit_limit_set_at") @db.Timestamptz
  balance                BigInt             @default(0)
  status                 RelationshipStatus @default(ACTIVE)
  endedByParty           RelationshipParty? @map("ended_by_party")
  supplierNotes          String?            @map("supplier_notes") @db.Text
  createdById            String             @map("created_by_id") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz
  mergedIntoId           String?            @map("merged_into_id") @db.Uuid
  serverUpdatedAt        DateTime           @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt              DateTime?          @map("deleted_at") @db.Timestamptz

  supplierOrganization Organization?                      @relation("RelationshipSupplierOrganization", fields: [supplierOrganizationId], references: [id])
  supplierPerson       Person?                            @relation("RelationshipSupplierPerson", fields: [supplierPersonId], references: [id])
  customerPerson       Person?                            @relation("RelationshipCustomerPerson", fields: [customerPersonId], references: [id])
  customerOrganization Organization?                      @relation("RelationshipCustomerOrganization", fields: [customerOrganizationId], references: [id])
  creditLimitSetBy     Person?                            @relation("RelationshipCreditLimitSetBy", fields: [creditLimitSetById], references: [id])
  createdBy            Person                             @relation("RelationshipCreatedBy", fields: [createdById], references: [id])
  mergedInto           CustomerRelationship?              @relation("RelationshipMergedInto", fields: [mergedIntoId], references: [id])
  mergedDuplicates     CustomerRelationship[]             @relation("RelationshipMergedInto")
  creditLimitChanges   CreditLimitChange[]
  reassignments        CustomerRelationshipReassignment[]
  customerPrices       CustomerPrice[]
  orders               Order[]
  ledgerEntries        LedgerEntry[]

  @@index([supplierOrganizationId])
  @@index([supplierPersonId])
  @@index([customerPersonId])
  @@index([customerOrganizationId])
  @@map("customer_relationships")
}

// Rules the database enforces on the credit limit journal, beyond what this
// model declares. All come from migration 20261004150000_rel_003_credit_limit_changes.
// - The journal can only grow: the application can add and read entries but
//   never change, delete or empty them.
// - The person who set the limit must be a registered person, never a guest.
//   This is checked when the transaction is saved, not row by row.
// - server_updated_at is set by the database on every change.
// - An empty previous_limit or new_limit means "no ceiling"; zero is a real
//   limit (no credit).
model CreditLimitChange {
  id                     String   @id @db.Uuid
  customerRelationshipId String   @map("customer_relationship_id") @db.Uuid
  previousLimit          BigInt?  @map("previous_limit")
  newLimit               BigInt?  @map("new_limit")
  setById                String   @map("set_by_id") @db.Uuid
  setAt                  DateTime @default(now()) @map("set_at") @db.Timestamptz
  serverUpdatedAt        DateTime @default(now()) @map("server_updated_at") @db.Timestamptz

  customerRelationship CustomerRelationship @relation(fields: [customerRelationshipId], references: [id])
  setBy                Person               @relation(fields: [setById], references: [id])

  @@index([customerRelationshipId])
  @@map("credit_limit_changes")
}

// Rules the database enforces on the journal of customer changes on a
// relationship, beyond what this model declares. All come from migration
// 20261004160000_rel_014_reassignments.
// - The journal can only grow: the application can add and read entries but
//   never change, delete or empty them.
// - The person who made the change must be a registered person, never a guest.
//   This is checked when the transaction is saved, not row by row.
// - A contestation is an entry where the person who made the change is the
//   previous person themselves. A relationship accepts only one contestation
//   per previous person; corrections by anyone else are not limited. This is a
//   partial unique index that Prisma cannot express, so code must not rely on a
//   Prisma unique lookup; catch the unique violation (23505) instead.
// - server_updated_at is set by the database on every change.
// The rule that the new person has no relationship with the same supplier is
// checked by the code that writes entries (REL-023, REL-024), not here.
model CustomerRelationshipReassignment {
  id                     String   @id @db.Uuid
  customerRelationshipId String   @map("customer_relationship_id") @db.Uuid
  previousPersonId       String   @map("previous_person_id") @db.Uuid
  newPersonId            String   @map("new_person_id") @db.Uuid
  reassignedById         String   @map("reassigned_by_id") @db.Uuid
  reason                 String?  @db.Text
  reassignedAt           DateTime @default(now()) @map("reassigned_at") @db.Timestamptz
  serverUpdatedAt        DateTime @default(now()) @map("server_updated_at") @db.Timestamptz

  customerRelationship CustomerRelationship @relation(fields: [customerRelationshipId], references: [id])
  previousPerson       Person               @relation("ReassignmentPreviousPerson", fields: [previousPersonId], references: [id])
  newPerson            Person               @relation("ReassignmentNewPerson", fields: [newPersonId], references: [id])
  reassignedBy         Person               @relation("ReassignmentAuthor", fields: [reassignedById], references: [id])

  @@index([customerRelationshipId])
  @@map("customer_relationship_reassignments")
}

// Rules the database enforces on one-time codes, beyond what this model
// declares. Both come from migration 20261003150000_auth_001_otp_challenges.
// - A code can be tried at most 5 times.
// - A code sent by SMS can only go to a Cameroon number, starting with +237.
model OtpChallenge {
  id         String     @id @db.Uuid
  personId   String?    @map("person_id") @db.Uuid
  target     String
  purpose    OtpPurpose
  channel    OtpChannel @default(SMS)
  codeHash   String     @map("code_hash")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz
  attempts   Int        @default(0)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  person Person? @relation(fields: [personId], references: [id])

  @@index([target, purpose, createdAt(sort: Desc)])
  @@map("otp_challenges")
}

model IdempotencyKey {
  personId     String   @map("person_id") @db.Uuid
  key          String   @db.Uuid
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([personId, key])
  @@map("idempotency_keys")
}

// Rules the database enforces on the phone number change history, beyond what
// this model declares. All come from migration
// 20261002212000_per_003_phone_change_log.
// - The old and new numbers are stored in international format: a "+", then up
//   to 15 digits, the first not 0.
// - The history can only grow: the application can add entries but never
//   change or delete them.
// - server_updated_at is set by the database on every change.
model PhoneNumberChangeLog {
  id              String    @id @db.Uuid
  personId        String    @map("person_id") @db.Uuid
  oldPhoneNumber  String    @map("old_phone_number")
  newPhoneNumber  String    @map("new_phone_number")
  verifiedAt      DateTime  @map("verified_at") @db.Timestamptz
  changedAt       DateTime  @map("changed_at") @db.Timestamptz
  serverUpdatedAt DateTime  @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  person Person @relation(fields: [personId], references: [id])

  @@index([personId])
  @@map("phone_number_change_logs")
}

// Database detail for devices, not declared in this model:
// - The database keeps an index to quickly find a person's devices that are
//   still allowed (not revoked). Prisma cannot declare an index limited to some
//   rows, so it exists only in migration
//   20261003160000_auth_007_devices_refresh_tokens.
model Device {
  id               String         @id @db.Uuid
  personId         String         @map("person_id") @db.Uuid
  platform         DevicePlatform
  model            String?
  pushToken        String?        @map("push_token")
  appVersion       String         @map("app_version")
  lastSyncedAt     DateTime?      @map("last_synced_at") @db.Timestamptz
  scopeVersionSeen Int            @default(0) @map("scope_version_seen")
  integrityVerdict String?        @map("integrity_verdict")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz

  person        Person         @relation(fields: [personId], references: [id])
  refreshTokens RefreshToken[]

  @@map("devices")
}

// Rule the database enforces on refresh tokens, beyond what this model declares:
// - A revoked token always records both when and why it was revoked; a token
//   that is not revoked has neither.
//   (Migration 20261003160000_auth_007_devices_refresh_tokens)
model RefreshToken {
  id            String                     @id @db.Uuid
  personId      String                     @map("person_id") @db.Uuid
  deviceId      String                     @map("device_id") @db.Uuid
  tokenHash     String                     @unique @map("token_hash")
  expiresAt     DateTime                   @map("expires_at") @db.Timestamptz
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  rotatedAt     DateTime?                  @map("rotated_at") @db.Timestamptz
  revokedAt     DateTime?                  @map("revoked_at") @db.Timestamptz
  revokedReason RefreshTokenRevokedReason? @map("revoked_reason")

  person Person @relation(fields: [personId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])

  @@index([personId])
  @@index([deviceId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Rules the database enforces on administrators, beyond what this model
// declares. All come from migration 20261004170000_adm_001_administrators.
// - The two-factor secret is required and cannot be empty or only spaces. The
//   database cannot tell whether it is properly encrypted; the code does that.
// - The person must be a registered person, never a guest. This is checked
//   when the transaction is saved, not row by row.
// - A person has at most one live row (removed_at empty). Once removed, the
//   person can be appointed again with a new row. This is a partial unique
//   index that Prisma cannot express, so code must not rely on a Prisma unique
//   lookup; catch the unique violation (23505) instead.
// - The recovery email, when given, must differ from the person's own email,
//   whatever the upper or lower case. It is checked on every insert or update
//   of the administrator row, not when the person's email changes later.
model Administrator {
  id            String            @id @db.Uuid
  personId      String            @map("person_id") @db.Uuid
  role          AdministratorRole
  totpSecret    String            @map("totp_secret") @db.Text
  recoveryEmail String?           @map("recovery_email")
  appointedAt   DateTime          @default(now()) @map("appointed_at") @db.Timestamptz
  removedAt     DateTime?         @map("removed_at") @db.Timestamptz

  person Person @relation(fields: [personId], references: [id])

  actions         AdminAction[]
  resolvedReports Report[]

  @@index([personId])
  @@map("administrators")
}

// Rules the database enforces on the journal of administrator actions, beyond
// what this model declares. All come from migration
// 20261004180000_adm_002_admin_actions.
// - The journal can only grow: the application can add and read entries but
//   never change, delete or empty them.
// - An entry has exactly one target: a person or an organization, never both
//   and never none.
// - The reason is required and cannot be empty or only spaces.
// - A sync archive is attached exactly when the action is REPLAY_SYNC, and
//   only an administrator whose role is SUPER_ADMIN can record a REPLAY_SYNC
//   (checked on the administrator's role at the time of the insert).
// - report_id must point to an existing report (foreign key added by migration
//   20261004190000_adm_003_reports). sync_archive_id is a plain column for now:
//   its foreign key to sync archives is added by SYNC-002.
// - server_updated_at is set by the database on every change.
model AdminAction {
  id                   String          @id @db.Uuid
  administratorId      String          @map("administrator_id") @db.Uuid
  action               AdminActionType
  targetPersonId       String?         @map("target_person_id") @db.Uuid
  targetOrganizationId String?         @map("target_organization_id") @db.Uuid
  reportId             String?         @map("report_id") @db.Uuid
  syncArchiveId        String?         @map("sync_archive_id") @db.Uuid
  reason               String          @db.Text
  occurredAt           DateTime        @default(now()) @map("occurred_at") @db.Timestamptz
  serverUpdatedAt      DateTime        @default(now()) @map("server_updated_at") @db.Timestamptz

  administrator      Administrator @relation(fields: [administratorId], references: [id])
  report             Report?       @relation(fields: [reportId], references: [id])
  targetPerson       Person?       @relation("AdminActionTargetPerson", fields: [targetPersonId], references: [id])
  targetOrganization Organization? @relation("AdminActionTargetOrganization", fields: [targetOrganizationId], references: [id])

  @@index([administratorId])
  @@index([targetPersonId])
  @@index([targetOrganizationId])
  @@index([reportId])
  @@map("admin_actions")
}

// Rules the database enforces on reports, beyond what this model declares. All
// come from migration 20261004190000_adm_003_reports.
// - A report has exactly one target: a person or an organization, never both
//   and never none. This also holds when an existing report is updated.
// - The reporter must be a registered person, never a guest. This is checked
//   when the transaction is saved, not row by row.
// - resolved_by_id must be an administrator (not just any person).
// - A new report is PENDING and reported_at is set by the database; the
//   database does not check that status, decision, resolved_at and
//   resolved_by_id agree with each other: the resolution code does that.
// - server_updated_at is set by the database on every change.
model Report {
  id                   String          @id @db.Uuid
  reporterId           String          @map("reporter_id") @db.Uuid
  targetPersonId       String?         @map("target_person_id") @db.Uuid
  targetOrganizationId String?         @map("target_organization_id") @db.Uuid
  reason               String          @db.Text
  description          String          @db.Text
  status               ReportStatus    @default(PENDING)
  reportedAt           DateTime        @default(now()) @map("reported_at") @db.Timestamptz
  resolvedAt           DateTime?       @map("resolved_at") @db.Timestamptz
  resolvedById         String?         @map("resolved_by_id") @db.Uuid
  decision             ReportDecision?
  serverUpdatedAt      DateTime        @default(now()) @map("server_updated_at") @db.Timestamptz

  reporter           Person         @relation("ReportReporter", fields: [reporterId], references: [id])
  targetPerson       Person?        @relation("ReportTargetPerson", fields: [targetPersonId], references: [id])
  targetOrganization Organization?  @relation("ReportTargetOrganization", fields: [targetOrganizationId], references: [id])
  resolvedBy         Administrator? @relation(fields: [resolvedById], references: [id])

  adminActions AdminAction[]

  @@index([reporterId])
  @@index([targetPersonId])
  @@index([targetOrganizationId])
  @@index([resolvedById])
  @@map("reports")
}

// Rules the database enforces on products (the articles an organization sells),
// beyond what this model declares. All come from migration
// 20261004200000_cat_001_products.
// - The price must be greater than zero, and the minimum order quantity, when
//   given, must be greater than zero. A quantity is rounded to 3 decimals
//   first, so 0.0004 counts as 0 and is refused.
// - price_updated_at is set by the database when the product is created and
//   moves only when the price really changes. A value sent by the code is
//   ignored, so never try to set it yourself.
// - server_updated_at is set by the database on every change.
model Product {
  id               String        @id @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  name             String
  unit             String
  price            BigInt
  priceUpdatedAt   DateTime      @default(now()) @map("price_updated_at") @db.Timestamptz
  minOrderQuantity Decimal?      @map("min_order_quantity") @db.Decimal(12, 3)
  description      String?       @db.Text
  category         String?
  status           ProductStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  serverUpdatedAt  DateTime      @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz

  organization   Organization    @relation(fields: [organizationId], references: [id])
  customerPrices CustomerPrice[]
  orderLines     OrderLine[]

  @@index([organizationId])
  @@map("products")
}

// Rules the database enforces on negotiated prices (one customer's own price
// for one product), beyond what this model declares. All come from migration
// 20261004210000_cat_002_customer_prices.
// - The product must belong to the organization that is the supplier of the
//   relationship. A relationship whose supplier is a person has no products, so
//   it can never hold a price. Checked on every insert and every change of the
//   relationship or product, even for code that skipped validation.
// - Only one live price may exist per relationship and product. Deleted rows do
//   not count, so a price can be set again after it was deleted. This is a
//   partial unique index that Prisma cannot express, so code must not rely on a
//   Prisma unique lookup; catch the unique violation (23505) instead.
// - The person who set the price must be a registered person, never a guest.
//   This is checked when the transaction is saved, not row by row.
// - set_at is the creation time given by the database. server_updated_at is set
//   by the database on every change.
// The rule that a price is positive is checked by the routes (CAT-008), not here.
model CustomerPrice {
  id                     String    @id @db.Uuid
  customerRelationshipId String    @map("customer_relationship_id") @db.Uuid
  productId              String    @map("product_id") @db.Uuid
  price                  BigInt
  setById                String    @map("set_by_id") @db.Uuid
  setAt                  DateTime  @default(now()) @map("set_at") @db.Timestamptz
  serverUpdatedAt        DateTime  @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz

  customerRelationship CustomerRelationship @relation(fields: [customerRelationshipId], references: [id])
  product              Product              @relation(fields: [productId], references: [id])
  setBy                Person               @relation("CustomerPriceSetBy", fields: [setById], references: [id])

  @@index([customerRelationshipId])
  @@index([productId])
  @@map("customer_prices")
}

// Rules the database enforces on orders (a customer's purchase from a
// supplier), beyond what this model declares. All come from migration
// 20261004220000_ord_001_orders.
// - The person who entered the order, the one who delivered it and the one who
//   cancelled it must be registered people, never guests. This is checked when
//   the transaction is saved, not row by row.
// - server_updated_at is set by the database on every change.
// - An order can point to a parent order (parent_order_id), for example a
//   follow-up order; the parent must exist.
// Status, cancellation and delivery rules come from migration
// 20261004280000_ord_002_status_rules:
// - The cancelling party, the cancelling person and the cancellation time are
//   all filled when the order is CANCELLED and all empty otherwise. A reason is
//   only allowed on a cancelled order, and is required when the supplier
//   cancelled it.
// - A PENDING order must have been placed by the customer.
// - The delivery time and the delivering person are both filled when the order
//   is DELIVERED and both empty otherwise.
// - Status can only follow the permitted steps: PENDING to CONFIRMED or
//   CANCELLED; CONFIRMED to IN_DELIVERY, DELIVERED or CANCELLED; IN_DELIVERY to
//   DELIVERED or CONFIRMED (failed attempt). A CANCELLED order can become
//   DELIVERED only if sync_issue is set in the same update (the delivery wins);
//   the database then clears the cancellation columns itself. A DELIVERED order
//   can never be cancelled.
// - A DELIVERED or CANCELLED order is frozen: only supplier_note, sync_issue and
//   server_updated_at may change. Any other change fails with a check error
//   (SQLSTATE 23514), so code must not try to edit a finished order.
// These are CHECK constraints and a trigger, which Prisma cannot express.
// - An order can only be created on a relationship that is ACTIVE, not deleted
//   and has an organization as supplier, and that organization must be ACTIVE
//   (not suspended or closed); otherwise the insert fails with a check error
//   (SQLSTATE 23514). Counters (no customer) are allowed. Only inserts are
//   checked, so existing orders of a closed business stay editable within the
//   rules above. (Migration 20261004290000_ord_003_creation_guard)
// - The total must equal the sum of the amounts of the order's non-deleted lines
//   plus the delivery cost; an order with no lines must have a total equal to
//   its delivery cost. A DELIVERED order needs a delivered quantity on every
//   non-deleted line. The database checks this when the transaction is saved
//   (not statement by statement), so lines and total may be written in any order
//   but must agree at commit; otherwise the commit fails with SQLSTATE 23514.
//   Code must change a line and the total in the same transaction.
//   (Migration 20261004320000_ord_006_total_check, a deferred constraint trigger
//   on orders and order_lines.)
model Order {
  id                     String      @id @db.Uuid
  customerRelationshipId String      @map("customer_relationship_id") @db.Uuid
  placedByParty          OrderParty  @map("placed_by_party")
  enteredById            String      @map("entered_by_id") @db.Uuid
  deliveryAddressApplied String?     @map("delivery_address_applied")
  totalAmount            BigInt      @map("total_amount")
  deliveryCost           BigInt      @default(0) @map("delivery_cost")
  status                 OrderStatus @default(CONFIRMED)
  deliveredAt            DateTime?   @map("delivered_at") @db.Timestamptz
  deliveredById          String?     @map("delivered_by_id") @db.Uuid
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz
  desiredDeliveryDate    DateTime?   @map("desired_delivery_date") @db.Date
  cancelledByParty       OrderParty? @map("cancelled_by_party")
  cancelledById          String?     @map("cancelled_by_id") @db.Uuid
  cancelledAt            DateTime?   @map("cancelled_at") @db.Timestamptz
  cancellationReason     String?     @map("cancellation_reason") @db.Text
  parentOrderId          String?     @map("parent_order_id") @db.Uuid
  customerNote           String?     @map("customer_note") @db.Text
  supplierNote           String?     @map("supplier_note") @db.Text
  syncIssue              String?     @map("sync_issue") @db.Text
  serverUpdatedAt        DateTime    @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt              DateTime?   @map("deleted_at") @db.Timestamptz

  customerRelationship CustomerRelationship @relation(fields: [customerRelationshipId], references: [id])
  enteredBy            Person               @relation("OrderEnteredBy", fields: [enteredById], references: [id])
  deliveredBy          Person?              @relation("OrderDeliveredBy", fields: [deliveredById], references: [id])
  cancelledBy          Person?              @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  parentOrder          Order?               @relation("OrderParent", fields: [parentOrderId], references: [id])
  childOrders          Order[]              @relation("OrderParent")
  ledgerEntries        LedgerEntry[]
  deliveries           Delivery[]
  lines                OrderLine[]

  @@index([customerRelationshipId])
  @@index([status])
  @@index([deliveredById, deliveredAt])
  @@map("orders")
}

// Rules the database enforces on order lines, beyond what this model declares.
// Those below come from migration 20261004300000_ord_004_order_lines.
// - The quantity must be greater than zero. The delivered quantity, when given,
//   is between zero and the quantity.
// - The reference price and the applied price are never negative.
// - The amount is worked out as quantity times applied price in whole francs,
//   half a franc rounded up. When a delivered quantity exists it replaces the
//   ordered quantity in that calculation. The database refuses any other amount
//   (SQLSTATE 23514), so code must compute it (lineAmount) and also send a new
//   amount whenever it changes a quantity or a price.
// - price_set_by_id and price_set_at are both filled exactly when the applied
//   price differs from the reference price, and both empty otherwise. A price
//   change without its author, or an author without a price change, is refused.
// - The person who set the price must be a registered person, never a guest.
//   This is checked when the transaction is saved, not row by row.
// - server_updated_at is set by the database on every change.
// Migration 20261004310000_ord_005_line_rules adds a trigger that reads other tables:
// - On insert the product must be an ACTIVE, undeleted product of the supplier
//   organization of the order's relationship, otherwise SQLSTATE 23514. On an
//   order placed by the CUSTOMER the quantity must also reach the product's
//   minimum order quantity, when it has one. Neither is re-checked on update, so
//   a later product change never blocks an old order.
// - On an order placed by the CUSTOMER the applied price must equal the reference
//   price on insert, and may later be lowered but never raised above it (the
//   supplier can only lower it). Lowering needs the price author and time as
//   above. Supplier-placed orders have no such limit.
// Migration 20261004320000_ord_006_total_check: adding, changing, moving or
// removing a line (and soft-deleting it) re-checks its order's total at commit.
// The order's total must equal the sum of its non-deleted line amounts plus its
// delivery cost, so a line change must come with the matching total change in
// the same transaction (SQLSTATE 23514 otherwise). A DELIVERED order needs a
// delivered quantity on every non-deleted line.
// These are CHECK constraints and triggers, which Prisma cannot express.
model OrderLine {
  id                String    @id @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  labelApplied      String    @map("label_applied")
  quantity          Decimal   @db.Decimal(12, 3)
  deliveredQuantity Decimal?  @map("delivered_quantity") @db.Decimal(12, 3)
  referencePrice    BigInt    @map("reference_price")
  unitPriceApplied  BigInt    @map("unit_price_applied")
  amount            BigInt
  priceSetById      String?   @map("price_set_by_id") @db.Uuid
  priceSetAt        DateTime? @map("price_set_at") @db.Timestamptz
  serverUpdatedAt   DateTime  @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
  priceSetBy Person? @relation("OrderLinePriceSetBy", fields: [priceSetById], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_lines")
}

// Rules the database enforces on the ledger, beyond what this model declares.
// All come from migration 20261004230000_fin_001_ledger_entries.
// - The ledger can only grow: the application can add and read entries but
//   never change, delete or empty them. A mistake is fixed by adding a
//   reversing entry (reverses_entry_id), never by editing a line.
// - balance_effect is worked out by the database from kind, amount and
//   reverses_entry_id, and is stored. Code must never write it: an insert that
//   names it fails. A SALE, OPENING_BALANCE or REFUND raises what the customer
//   owes by the amount; a PAYMENT or CREDIT_NOTE lowers it. An entry that
//   reverses another has the opposite sign. Prisma cannot express a generated
//   column, so it is declared with an unknown default here; leave it out of
//   every create call.
// - The amount is always above zero; the sign lives in balance_effect.
// - A mode (CASH or MOBILE_MONEY) is given exactly when the kind is PAYMENT or
//   REFUND, and never otherwise.
// - The person who recorded the entry must be a registered person, never a
//   guest. This is checked when the transaction is saved, not row by row.
// - server_updated_at is set by the database on every change. There is no
//   deleted_at: entries are never removed.
// The rules on who may record which entry, reversals and sales are added by
// later stories (FIN-002), not here.
model LedgerEntry {
  id                     String           @id @db.Uuid
  customerRelationshipId String           @map("customer_relationship_id") @db.Uuid
  orderId                String?          @map("order_id") @db.Uuid
  kind                   LedgerEntryKind
  amount                 BigInt
  balanceEffect          BigInt           @default(dbgenerated()) @map("balance_effect")
  mode                   LedgerEntryMode?
  transactionReference   String?          @map("transaction_reference")
  reversesEntryId        String?          @map("reverses_entry_id") @db.Uuid
  recordedById           String           @map("recorded_by_id") @db.Uuid
  note                   String?          @db.Text
  occurredAt             DateTime         @map("occurred_at") @db.Timestamptz
  serverUpdatedAt        DateTime         @default(now()) @map("server_updated_at") @db.Timestamptz

  customerRelationship CustomerRelationship @relation(fields: [customerRelationshipId], references: [id])
  order                Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reversesEntry        LedgerEntry?         @relation("LedgerEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversals            LedgerEntry[]        @relation("LedgerEntryReversal")
  recordedBy           Person               @relation("LedgerEntryRecordedBy", fields: [recordedById], references: [id])

  @@index([customerRelationshipId, occurredAt(sort: Desc)])
  @@index([orderId])
  @@index([recordedById, occurredAt])
  @@map("ledger_entries")
}

// Rules the database enforces on expenses (money leaving the business), beyond
// what this model declares. All come from migration 20261004240000_fin_011_expenses.
// - The amount is always above zero.
// - The person who paid must have a membership in the organization, active or
//   not (someone who has left can still be owed or have paid). A deleted
//   membership still counts. Checked on every insert.
// - The people who recorded the expense and the one who cancelled it must be
//   registered people, never guests. This is checked when the transaction is
//   saved, not row by row.
// - cancelled_at and cancelled_by_id are both filled in or both empty.
// - An expense is never edited. The only change allowed is to cancel it, once,
//   by filling in cancelled_at and cancelled_by_id together; any other change
//   (including a second cancellation or removing one) is refused. Code must
//   never try to correct an expense: cancel it and record a new one.
// - server_updated_at is set by the database on every change.
// Routes and who may record or cancel an expense come later (FIN-012, FIN-013).
model Expense {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  paidById        String    @map("paid_by_id") @db.Uuid
  amount          BigInt
  category        String?
  description     String?   @db.Text
  recordedById    String    @map("recorded_by_id") @db.Uuid
  occurredAt      DateTime  @map("occurred_at") @db.Timestamptz
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledById   String?   @map("cancelled_by_id") @db.Uuid
  serverUpdatedAt DateTime  @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  paidBy       Person       @relation("ExpensePaidBy", fields: [paidById], references: [id])
  recordedBy   Person       @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  cancelledBy  Person?      @relation("ExpenseCancelledBy", fields: [cancelledById], references: [id])

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([paidById])
  @@map("expenses")
}

// Rules the database enforces on handovers (money passing from one
// collaborator to another), beyond what this model declares. All come from
// migration 20261004250000_fin_014_handovers.
// - The amount is always above zero.
// - The sender must have a membership in the organization, active or not,
//   deleted or not (someone who has left can still hand over money).
// - The receiver must have an ACTIVE membership as OWNER or MANAGER in the
//   organization. Both are checked on every insert.
// - Sender and receiver may be the same person: this is the former owner's
//   automatic handover. The routes refuse it for ordinary handovers; the
//   database does not.
// - The sender, receiver and the person who cancelled must be registered
//   people, never guests. This is checked when the transaction is saved, not
//   row by row.
// - cancelled_at and cancelled_by_id are both filled in or both empty.
// - A handover is never edited. The only change allowed is to cancel it, once,
//   by filling in cancelled_at and cancelled_by_id together; any other change
//   (including a second cancellation or removing one) is refused. Code must
//   never try to correct a handover: cancel it and record a new one.
// - server_updated_at is set by the database on every change.
// Routes and who may record or cancel a handover come later (FIN-015, FIN-016).
model Handover {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  fromPersonId    String    @map("from_person_id") @db.Uuid
  toPersonId      String    @map("to_person_id") @db.Uuid
  amount          BigInt
  occurredAt      DateTime  @map("occurred_at") @db.Timestamptz
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledById   String?   @map("cancelled_by_id") @db.Uuid
  serverUpdatedAt DateTime  @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  fromPerson   Person       @relation("HandoverFrom", fields: [fromPersonId], references: [id])
  toPerson     Person       @relation("HandoverTo", fields: [toPersonId], references: [id])
  cancelledBy  Person?      @relation("HandoverCancelledBy", fields: [cancelledById], references: [id])

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([fromPersonId])
  @@index([toPersonId])
  @@map("handovers")
}

// Rules the database enforces on deliveries (one row per delivery attempt of
// an order), beyond what this model declares. All come from migration
// 20261004260000_dlv_001_deliveries.
// - An order can have several deliveries (one per attempt); the order must
//   exist, and the driver (assigned_to_id) is required.
// - The driver must be a registered person, never a guest. This is checked
//   when the transaction is saved, not row by row.
// - departed_at, arrived_at and failed_at start empty; failure_reason and
//   sync_issue are free text and optional.
// - server_updated_at is set by the database on every change.
// The rules below come from migration 20261004320000_dlv_002_delivery_rules.
// - A delivery cannot be both arrived and failed. A failure reason is given
//   exactly when the delivery failed.
// - An order has at most one delivery in progress (neither arrived nor failed).
//   Deleted deliveries do not count, so that rule is not written as @@unique.
// - When a delivery is created, its driver must be an active collaborator of
//   the supplier organization of the order's relationship, whatever their
//   role. Only creation is checked: a delivery stays valid if the driver
//   later leaves.
model Delivery {
  id              String    @id @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  assignedToId    String    @map("assigned_to_id") @db.Uuid
  departedAt      DateTime? @map("departed_at") @db.Timestamptz
  arrivedAt       DateTime? @map("arrived_at") @db.Timestamptz
  failedAt        DateTime? @map("failed_at") @db.Timestamptz
  failureReason   String?   @map("failure_reason") @db.Text
  syncIssue       String?   @map("sync_issue") @db.Text
  serverUpdatedAt DateTime  @default(now()) @map("server_updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  order      Order  @relation(fields: [orderId], references: [id])
  assignedTo Person @relation("DeliveryAssignedTo", fields: [assignedToId], references: [id])

  @@index([orderId])
  @@index([assignedToId, departedAt])
  @@map("deliveries")
}
