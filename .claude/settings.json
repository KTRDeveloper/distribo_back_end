{
  "env": {
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false",

    "ANTHROPIC_BASE_URL": "http://localhost:20128/v1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "cx/gpt-5.6-sol-high",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "cx/gpt-5.6-sol-medium",
    "ANTHROPIC_DEFAULT_SONNET_MODEL3": "cx/gpt-5.6-sol-low",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "cx/gpt-5.6-sol-low",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL2": "agy/claude-sonnet-4-6"

  },
  "permissions": {
    "deny": [
      "Edit(./data-model/modele-donnees-livraisons.md)",
      "Write(./data-model/modele-donnees-livraisons.md)",
      "Read(./node_modules/**)",
      "Read(./built/**)",
      "Read(./coverage/**)",
      "Read(./yarn-error.log)",
      "Read(./.env)",
      "Read(./.env-dev)",
      "Read(./.env-godealy-prod)",
      "Read(./package.json.save)",
      "Read(./package.json.2saved)",
      "Read(./.eslintrc.json.save)",
      "Read(./jest.config.js.save)",
      "Grep(./node_modules/**)",
      "Grep(./built/**)",
      "Grep(./coverage/**)",
      "Glob(./node_modules/**)",
      "Glob(./built/**)",
      "Glob(./coverage/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-data-model.cjs",
            "statusMessage": "Checking data-model protection..."
          }
        ]
      }
    ]
  }
}
