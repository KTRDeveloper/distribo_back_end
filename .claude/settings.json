{
  "autoCompactWindow": 200000,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false",
    "NO_COLOR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(node .claude/skills/implement-stories/scripts/select.mjs *)",
      "Bash(node .claude/skills/implement-stories/scripts/set-status.mjs *)",
      "Bash(node .claude/skills/implement-stories/scripts/report.mjs *)",
      "Bash(sleep 60)"
    ],
    "deny": [
      "Edit(./data-model/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(./package-lock.json)",
      "Read(./openapi/openapi.json)",
      "Read(./docs/stories/_meta/baseline/**)",
      "Read(./docs/stories/_meta/index.json)",
      "Read(./docs/stories/_meta/backlog.json)",
      "Read(./docs/stories/_meta/model.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-data-model.cjs",
            "statusMessage": "Checking data-model protection..."
          }
        ]
      }
    ]
  }
}
